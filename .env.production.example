# Production Environment Variables for Hostinger
# Copy these to Node.js App Environment Variables in cPanel

# Supabase / PostgreSQL Database Configuration
# Copy this value from your Supabase project > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:your-password@db.xxxxxx.supabase.co:5432/postgres
# Optional alternative names if your hosting uses them
# SUPABASE_URL=postgresql://postgres:your-password@db.xxxxxx.supabase.co:5432/postgres

# MySQL Database Configuration (fallback only)
# Note: Hostinger adds your username prefix to database names
# Example: if username is "user123", database becomes "user123_bors_db"
DB_HOST=localhost
DB_USER=your_cpanel_username_dbuser
DB_PASSWORD=your_strong_database_password
DB_NAME=your_cpanel_username_bors_db

# Session Secret (IMPORTANT: Change this to a random string)
# Generate at: https://randomkeygen.com/
SESSION_SECRET=change-this-to-random-string-in-production

# Server Port (usually 3000 for Hostinger Node.js apps)
PORT=3000

# Email Configuration (Gmail)
EMAIL_USER=marlonaberte00@gmail.com
EMAIL_PASSWORD=dvcrgktumaamydwe

# Secretary Email (for indigency request notifications)
SECRETARY_EMAIL=secretary@barangay.com

# Node Environment
NODE_ENV=production

# Application URL (for email links, etc.)
APP_URL=https://barangay.travelrequest.online

# Optional: Enable debug mode (set to false in production)
DEBUG=false

# Optional: Maximum upload file size (in MB)
MAX_FILE_SIZE=10
