<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add Resident | BORS</title>
  <link rel="stylesheet" href="/tailwind.css" />
  <link rel="stylesheet" href="/custom-styles.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gradient-to-br from-gray-50 to-green-50 text-gray-800 font-sans">

  {{> head }}
  {{> navbar }}

  <section class="bg-gradient-to-r from-green-600 to-green-800 py-8 md:py-12 shadow-2xl">
    <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-3 mb-2">
          <i data-lucide="user-plus" class="w-10 h-10 text-white"></i>
          <h1 class="text-2xl md:text-4xl font-extrabold text-white">Add New Resident</h1>
        </div>
        <p class="text-sm md:text-base text-green-100">Fill out the details below to register a new barangay resident</p>
      </div>
      <a href="/residents"
         class="btn-ripple bg-white text-green-800 hover:bg-green-50 px-5 py-3 rounded-xl font-bold shadow-lg transition-all flex items-center gap-2 hover:scale-105">
        <i data-lucide="arrow-left" class="w-5 h-5"></i>
        Back
      </a>
    </div>
  </section>

  <section class="max-w-4xl mx-auto bg-white mt-6 md:mt-10 shadow-2xl rounded-3xl p-6 md:p-10 border-2 border-gray-200 animate-fadeIn">
    <form action="/residents/add" method="POST" enctype="multipart/form-data" class="grid md:grid-cols-2 gap-6">

      <!-- Profile Upload -->
      <div class="md:col-span-2 text-center">
        <label class="block text-sm font-semibold text-gray-700 mb-2">Profile Photo</label>
        
        <div class="flex flex-col items-center">
          <img id="previewImage" src="/images/default-avatar.png" alt="Profile Preview"
               class="w-32 h-32 rounded-full object-cover border-4 border-green-600 shadow-sm mb-3" />
          <input type="file" name="profile" accept="image/*"
                 class="w-full text-sm text-gray-600 border border-gray-300 rounded-lg cursor-pointer px-3 py-2 focus:ring-2 focus:ring-green-600 outline-none"
                 onchange="previewProfile(event)">
          <p class="text-xs text-gray-500 mt-1">Upload a clear photo (JPEG/PNG)</p>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">First Name</label>
        <input type="text" name="first_name" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-green-600 outline-none">
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Last Name</label>
        <input type="text" name="last_name" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-green-600 outline-none">
      </div>

      <div class="md:col-span-2">
        <label class="block text-sm font-semibold text-gray-700 mb-1">Address</label>
        <input type="text" name="address" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-green-600 outline-none">
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Purok</label>
        <input type="text" name="purok" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-green-600 outline-none">
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Birthdate</label>
        <input type="date" name="birthdate" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-green-600 outline-none">
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Gender</label>
        <select name="gender" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-green-600 outline-none">
          <option value="">Select Gender</option>
          <option>Male</option>
          <option>Female</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Civil Status</label>
        <select name="civil_status" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-green-600 outline-none">
          <option value="">Select Status</option>
          <option>Single</option>
          <option>Married</option>
          <option>Widowed</option>
          <option>Separated</option>
        </select>
      </div>

      <div class="md:col-span-2">
        <label class="block text-sm font-semibold text-gray-700 mb-1">Contact Number</label>
        <input type="text" name="contact" placeholder="09XXXXXXXXX"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-green-600 outline-none">
      </div>

      <div class="md:col-span-2 flex justify-end mt-4 space-x-3">
        <button type="reset"
          class="bg-gray-300 hover:bg-gray-400 text-gray-700 px-6 py-2 rounded-lg font-medium transition">
          Reset
        </button>
        <button type="submit"
          class="bg-green-700 hover:bg-green-800 text-white px-6 py-2 rounded-lg font-medium transition">
          Save Resident
        </button>
      </div>
    </form>
  </section>

  {{> footer }}

  <script>
    // Initialize Lucide icons
    lucide.createIcons();
    
    function previewProfile(event) {
      const [file] = event.target.files;
      if (file) {
        document.getElementById('previewImage').src = URL.createObjectURL(file);
      }
    }
  </script>
</body>
</html>
