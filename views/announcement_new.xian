<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BORS | Add Announcement</title>
  <link rel="stylesheet" href="/tailwind.css" />
  <link rel="stylesheet" href="/custom-styles.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gradient-to-br from-gray-50 to-green-50 text-gray-800 font-sans">
  {{> head }}
  {{> navbar }}

  <!-- Page Header - Compact -->
  <section class="bg-gradient-to-r from-green-600 to-green-800 py-4 md:py-6 shadow-lg">
    <div class="max-w-5xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-3">
      <h1 class="text-xl md:text-3xl font-extrabold text-white flex items-center gap-2">
        <i data-lucide="megaphone" class="w-6 h-6 md:w-8 md:h-8"></i>
        Post New Announcement
      </h1>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 md:px-6 py-4 md:py-6 animate-fadeIn">
    <div class="bg-white shadow-2xl rounded-2xl p-4 md:p-6 border-2 border-gray-200"></div>

<form action="/announcement/new" method="POST" enctype="multipart/form-data" class="space-y-4">

  <!-- Two Column Layout for Desktop -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Title -->
    <div>
      <label class="block text-sm font-bold text-gray-700 mb-1 flex items-center gap-2">
        <i data-lucide="type" class="w-4 h-4 text-green-700"></i>
        Title
      </label>
      <input type="text" name="title" required placeholder="Enter announcement title"
        class="w-full px-3 py-2 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none text-sm" />
    </div>

    <!-- Posted By -->
    <div>
      <label class="block text-sm font-bold text-gray-700 mb-1 flex items-center gap-2">
        <i data-lucide="user" class="w-4 h-4 text-green-700"></i>
        Posted By
      </label>
      <input type="text" name="posted_by" required placeholder="Your name"
        class="w-full px-3 py-2 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none text-sm" />
    </div>
  </div>

  <!-- Message -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-1 flex items-center gap-2">
      <i data-lucide="message-square" class="w-4 h-4 text-green-700"></i>
      Message
    </label>
    <textarea name="message" required placeholder="Write your announcement message here..."
      class="w-full px-3 py-2 border-2 border-gray-300 rounded-xl h-24 resize-none focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none text-sm"></textarea>
  </div>

  <!-- Media Upload - Multiple Files -->
  <div>
    <label class="block text-sm font-bold text-gray-700 mb-1 flex items-center gap-2">
      <i data-lucide="images" class="w-4 h-4 text-green-700"></i>
      Upload Photos (Optional - Multiple)
    </label>
    <input type="file" name="media" accept="image/*,video/*" multiple
      class="w-full px-3 py-2 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none text-sm file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-green-100 file:text-green-700 file:font-semibold file:text-sm hover:file:bg-green-200" />
    <p class="text-xs text-gray-500 mt-1">You can select multiple images or videos</p>
  </div>

  <!-- Buttons -->
  <div class="flex gap-3 pt-2">
    <a href="/admin" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2.5 rounded-xl font-bold text-center transition-all text-sm">
      Cancel
    </a>
    <button type="submit" class="btn-ripple flex-1 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white px-4 py-2.5 rounded-xl font-bold shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-2 text-sm">
      <i data-lucide="send" class="w-4 h-4"></i>
      Post Announcement
    </button>
  </div>
</form>

    </div>
  </section>

  {{> footer }}

  <script>
    // Initialize Lucide icons
    lucide.createIcons();
  </script>
</body>
</html>
