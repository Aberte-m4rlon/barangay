<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Archived Announcements | BORS</title>
  <link rel="stylesheet" href="/tailwind.css">
  <link rel="stylesheet" href="/custom-styles.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gradient-to-br from-gray-50 to-green-50 text-gray-800">
  {{> head}}
  {{> navbar }}

  <!-- Header -->
  <section class="bg-gradient-to-r from-gray-600 via-gray-700 to-gray-800 py-10 md:py-16 text-center text-white shadow-2xl relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 left-0 w-64 h-64 bg-white rounded-full mix-blend-multiply filter blur-3xl animate-float"></div>
    </div>
    <div class="relative z-10 animate-fadeIn">
      <div class="flex justify-center mb-4">
        <i data-lucide="archive" class="w-16 h-16 text-white animate-pulse-slow"></i>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold mb-2">Archived Announcements</h1>
      <p class="text-gray-200 text-lg mb-6">Previously archived announcements</p>
      <a href="/announcements" class="inline-flex items-center gap-2 bg-white text-gray-800 hover:bg-gray-100 px-6 py-3 rounded-xl font-bold shadow-lg transition-all hover:scale-105">
        <i data-lucide="arrow-left" class="w-5 h-5"></i>
        Back to Active Announcements
      </a>
    </div>
  </section>

  <!-- Archived Announcements Container -->
  <div class="max-w-5xl mx-auto px-4 md:px-6 py-12 space-y-6 animate-fadeIn">
    {{#if announcements.length}}
      {{#each announcements}}
        <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all border-2 border-gray-300 hover:border-gray-400 hover-lift overflow-hidden opacity-75">
          <!-- Archived Badge -->
          <div class="bg-gray-600 text-white px-6 py-2 flex items-center gap-2">
            <i data-lucide="archive" class="w-4 h-4"></i>
            <span class="text-sm font-bold">ARCHIVED</span>
            {{#if this.archived_date}}
              <span class="text-xs ml-auto">Archived on {{this.archived_date}}</span>
            {{/if}}
          </div>

          <!-- Header -->
          <div class="p-6 md:p-8 border-b border-gray-200">
            <div class="flex items-start gap-3 mb-3">
              <div class="bg-gray-100 p-2 rounded-lg">
                <i data-lucide="bell" class="w-5 h-5 text-gray-600"></i>
              </div>
              <h2 class="text-xl md:text-2xl font-bold text-gray-700 flex-1">{{title}}</h2>
            </div>
            <p class="text-gray-600 leading-relaxed text-base md:text-lg">{{message}}</p>
          </div>

          <!-- Media Gallery -->
          {{#if this.media.length}}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 p-4 md:p-6 bg-gray-50">
              {{#each this.media}}
                {{#if (or (endsWith this ".jpg") (endsWith this ".jpeg") (endsWith this ".png") (endsWith this ".gif") (endsWith this ".webp"))}}
                  <div class="relative group overflow-hidden rounded-xl shadow-md">
                    <img src="/uploads/{{this}}" class="w-full h-64 object-cover group-hover:scale-110 transition-transform duration-300" alt="Announcement image">
                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-20 transition-all duration-300"></div>
                  </div>
                {{else if (or (endsWith this ".mp4") (endsWith this ".mov") (endsWith this ".avi") (endsWith this ".webm") (endsWith this ".mkv"))}}
                  <div class="relative rounded-xl overflow-hidden shadow-md">
                    <video controls class="w-full h-64 object-cover bg-black" preload="metadata">
                      <source src="/uploads/{{this}}" type="video/mp4">
                      Your browser does not support the video tag.
                    </video>
                  </div>
                {{/if}}
              {{/each}}
            </div>
          {{/if}}

          <!-- Footer -->
          <div class="p-6 md:p-8 bg-gradient-to-r from-gray-50 to-gray-100">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2 text-sm text-gray-600">
                <i data-lucide="user" class="w-4 h-4 text-gray-600"></i>
                <span class="font-semibold">{{posted_by}}</span>
                <span class="mx-2">•</span>
                <i data-lucide="calendar" class="w-4 h-4 text-gray-600"></i>
                <span>{{date_posted}}</span>
                {{#if this.media.length}}
                  <span class="mx-2">•</span>
                  <i data-lucide="images" class="w-4 h-4 text-gray-600"></i>
                  <span>{{this.media.length}} media</span>
                {{/if}}
              </div>
              <div class="flex gap-2">
                <button onclick="showRestoreModal('{{this._id}}')" class="btn-ripple bg-green-600 hover:bg-green-700 text-white px-3 py-2 rounded-lg text-xs font-semibold transition-all flex items-center gap-1 hover:scale-105">
                  <i data-lucide="rotate-ccw" class="w-3 h-3"></i>
                  Restore
                </button>
                <button onclick="showDeleteModal('{{this._id}}')" class="btn-ripple bg-red-600 hover:bg-red-700 text-white px-3 py-2 rounded-lg text-xs font-semibold transition-all flex items-center gap-1 hover:scale-105">
                  <i data-lucide="trash-2" class="w-3 h-3"></i>
                  Delete Forever
                </button>
              </div>
            </div>
          </div>
        </div>
      {{/each}}
    {{else}}
      <div class="text-center py-16 bg-white rounded-2xl shadow-lg">
        <i data-lucide="archive" class="w-20 h-20 text-gray-300 mx-auto mb-4"></i>
        <h3 class="text-xl font-bold text-gray-700 mb-2">No Archived Announcements</h3>
        <p class="text-gray-500 text-lg font-medium mb-6">You haven't archived any announcements yet</p>
        <a href="/announcements" class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-xl font-bold shadow-lg transition-all hover:scale-105">
          <i data-lucide="arrow-left" class="w-5 h-5"></i>
          Back to Announcements
        </a>
      </div>
    {{/if}}
  </div>

  {{> footer}}

  <!-- Restore Confirmation Modal -->
  <div id="restoreModal" class="hidden fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full animate-scaleIn">
      <div class="bg-gradient-to-r from-green-600 to-green-700 text-white p-6 rounded-t-3xl">
        <div class="flex items-center gap-3">
          <i data-lucide="rotate-ccw" class="w-8 h-8"></i>
          <h3 class="text-2xl font-bold">Restore Announcement?</h3>
        </div>
      </div>
      <div class="p-6">
        <p class="text-gray-700 mb-6">This announcement will be restored and visible to everyone again.</p>
        <div class="flex gap-3">
          <button onclick="closeRestoreModal()" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-3 rounded-xl font-bold transition-all">
            Cancel
          </button>
          <button onclick="confirmRestore()" class="flex-1 bg-green-600 hover:bg-green-700 text-white px-4 py-3 rounded-xl font-bold transition-all">
            Restore
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full animate-scaleIn">
      <div class="bg-gradient-to-r from-red-600 to-red-700 text-white p-6 rounded-t-3xl">
        <div class="flex items-center gap-3">
          <i data-lucide="alert-triangle" class="w-8 h-8"></i>
          <h3 class="text-2xl font-bold">Delete Forever?</h3>
        </div>
      </div>
      <div class="p-6">
        <p class="text-gray-700 mb-2 font-bold">⚠️ Warning: This action cannot be undone!</p>
        <p class="text-gray-600 mb-6">This will permanently delete this announcement from the database.</p>
        <div class="flex gap-3">
          <button onclick="closeDeleteModal()" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-3 rounded-xl font-bold transition-all">
            Cancel
          </button>
          <button onclick="confirmDelete()" class="flex-1 bg-red-600 hover:bg-red-700 text-white px-4 py-3 rounded-xl font-bold transition-all">
            Delete Forever
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Initialize Lucide icons
    lucide.createIcons();

    let currentAnnouncementId = null;

    // Restore Modal Functions
    function showRestoreModal(id) {
      currentAnnouncementId = id;
      document.getElementById('restoreModal').classList.remove('hidden');
      setTimeout(() => lucide.createIcons(), 100);
    }

    function closeRestoreModal() {
      document.getElementById('restoreModal').classList.add('hidden');
      currentAnnouncementId = null;
    }

    function confirmRestore() {
      if (currentAnnouncementId) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/announcement/restore/${currentAnnouncementId}`;
        document.body.appendChild(form);
        form.submit();
      }
    }

    // Delete Modal Functions
    function showDeleteModal(id) {
      currentAnnouncementId = id;
      document.getElementById('deleteModal').classList.remove('hidden');
      setTimeout(() => lucide.createIcons(), 100);
    }

    function closeDeleteModal() {
      document.getElementById('deleteModal').classList.add('hidden');
      currentAnnouncementId = null;
    }

    function confirmDelete() {
      if (currentAnnouncementId) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/announcement/delete/${currentAnnouncementId}`;
        document.body.appendChild(form);
        form.submit();
      }
    }

    // Close modals on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeRestoreModal();
        closeDeleteModal();
      }
    });

    // Close modals on backdrop click
    document.getElementById('restoreModal').addEventListener('click', function(e) {
      if (e.target === this) closeRestoreModal();
    });

    document.getElementById('deleteModal').addEventListener('click', function(e) {
      if (e.target === this) closeDeleteModal();
    });
  </script>
</body>
</html>
