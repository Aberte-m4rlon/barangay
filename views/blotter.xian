{{> head }}
<body class="bg-gradient-to-br from-gray-50 to-green-50 min-h-screen font-sans">
  {{> navbar }}
  
  <script>
    // Initialize Lucide icons immediately
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  </script>
  
  <div class="max-w-7xl mx-auto py-6 md:py-12 px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4 animate-fadeIn">
      <div class="flex items-center gap-3">
        <div class="bg-green-100 p-3 rounded-xl">
          <i data-lucide="clipboard-list" class="text-green-700 w-8 h-8 md:w-10 md:h-10"></i>
        </div>
        <div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-gray-800">Blotter Reports</h1>
          <p class="text-sm text-gray-600 mt-1">Manage incident reports and complaints</p>
        </div>
      </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-6 animate-fadeIn">
      <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-xl p-4 border-2 border-yellow-200 hover-lift">
        <div class="flex items-center gap-3">
          <div class="bg-yellow-500 p-2 rounded-lg">
            <i data-lucide="clock" class="w-5 h-5 text-white"></i>
          </div>
          <div>
            <p class="text-xs text-yellow-600 font-semibold">Pending</p>
            <p class="text-xl md:text-2xl font-bold text-yellow-700" id="pendingCount">0</p>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-4 border-2 border-green-200 hover-lift">
        <div class="flex items-center gap-3">
          <div class="bg-green-500 p-2 rounded-lg">
            <i data-lucide="check-circle" class="w-5 h-5 text-white"></i>
          </div>
          <div>
            <p class="text-xs text-green-600 font-semibold">Resolved</p>
            <p class="text-xl md:text-2xl font-bold text-green-700" id="resolvedCount">0</p>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-4 border-2 border-blue-200 hover-lift">
        <div class="flex items-center gap-3">
          <div class="bg-blue-500 p-2 rounded-lg">
            <i data-lucide="shield" class="w-5 h-5 text-white"></i>
          </div>
          <div>
            <p class="text-xs text-blue-600 font-semibold">Referred</p>
            <p class="text-xl md:text-2xl font-bold text-blue-700" id="referredCount">0</p>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl p-4 border-2 border-gray-200 hover-lift">
        <div class="flex items-center gap-3">
          <div class="bg-gray-500 p-2 rounded-lg">
            <i data-lucide="list" class="w-5 h-5 text-white"></i>
          </div>
          <div>
            <p class="text-xs text-gray-600 font-semibold">Total</p>
            <p class="text-xl md:text-2xl font-bold text-gray-700" id="totalCount">0</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white rounded-xl shadow-md p-4 mb-6 animate-fadeIn">
      <div class="flex flex-col md:flex-row gap-3">
        <div class="flex-1">
          <div class="relative">
            <i data-lucide="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400"></i>
            <input type="text" id="searchInput" placeholder="Search by name, type, or location..." 
              class="w-full pl-10 pr-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none text-sm">
          </div>
        </div>
        <select id="statusFilter" class="px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none text-sm">
          <option value="">All Status</option>
          <option value="Pending">Pending</option>
          <option value="Resolved">Resolved</option>
          <option value="Referred to Police">Referred to Police</option>
        </select>
        <button onclick="exportToCSV()" class="btn-ripple bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-4 py-2 rounded-lg font-semibold transition-all flex items-center gap-2 hover:scale-105">
          <i data-lucide="download" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Export</span>
        </button>
      </div>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-2xl shadow-2xl overflow-hidden border-2 border-gray-200 animate-fadeIn">
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm text-left border-collapse">
          <thead class="bg-gradient-to-r from-green-600 to-green-700 text-white">
            <tr>
              <th class="px-3 md:px-4 py-3 md:py-4 font-bold">Complainant</th>
              <th class="px-3 md:px-4 py-3 md:py-4 font-bold hidden md:table-cell">Respondent</th>
              <th class="px-3 md:px-4 py-3 md:py-4 font-bold">Incident Type</th>
              <th class="px-3 md:px-4 py-3 md:py-4 font-bold hidden lg:table-cell">Incident Date</th>
              <th class="px-3 md:px-4 py-3 md:py-4 font-bold">Status</th>
              <th class="px-3 md:px-4 py-3 md:py-4 text-center font-bold">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {{#each blotters}}
            <tr class="hover:bg-green-50 transition-colors blotter-row cursor-pointer" 
                data-status="{{status}}" 
                data-search="{{complainant_name}} {{respondent_name}} {{incident_type}} {{location}}"
                data-blotter='{"id":"{{_id}}","complainant":"{{complainant_name}}","complainant_address":"{{complainant_address}}","complainant_contact":"{{complainant_contact}}","respondent":"{{respondent_name}}","respondent_address":"{{respondent_address}}","respondent_contact":"{{respondent_contact}}","incident_type":"{{incident_type}}","incident_date":"{{incident_date}}","incident_time":"{{incident_time}}","location":"{{location}}","description":"{{description}}","status":"{{status}}","action_taken":"{{action_taken}}","reported_by":"{{reported_by}}","created_at":"{{created_at}}"}'>
              <td class="px-3 md:px-4 py-3 md:py-4 text-xs md:text-sm" onclick="viewBlotterDetails(this.parentElement)">
                <div class="font-semibold text-gray-800">{{complainant_name}}</div>
                <div class="text-gray-500 text-xs mt-1 md:hidden">vs {{respondent_name}}</div>
              </td>
              <td class="px-3 md:px-4 py-3 md:py-4 text-gray-600 text-xs md:text-sm hidden md:table-cell" onclick="viewBlotterDetails(this.parentElement)">{{respondent_name}}</td>
              <td class="px-3 md:px-4 py-3 md:py-4 text-xs md:text-sm" onclick="viewBlotterDetails(this.parentElement)">
                <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded-lg font-medium">{{incident_type}}</span>
              </td>
              <td class="px-3 md:px-4 py-3 md:py-4 text-gray-600 text-xs md:text-sm hidden lg:table-cell" onclick="viewBlotterDetails(this.parentElement)">
                <div class="flex items-center gap-1">
                  <i data-lucide="calendar" class="w-3 h-3"></i>
                  {{incident_date}}
                </div>
              </td>
              <td class="px-3 md:px-4 py-3 md:py-4" onclick="viewBlotterDetails(this.parentElement)">
                <span class="px-2 md:px-3 py-1 rounded-full text-xs font-bold inline-flex items-center gap-1
                  {{#if (eq status 'Resolved')}}bg-green-100 text-green-700
                  {{else if (eq status 'Referred to Police')}}bg-blue-100 text-blue-700
                  {{else}}bg-yellow-100 text-yellow-700{{/if}}">
                  {{#if (eq status 'Resolved')}}
                    <i data-lucide="check-circle" class="w-3 h-3"></i>
                  {{else if (eq status 'Referred to Police')}}
                    <i data-lucide="shield" class="w-3 h-3"></i>
                  {{else}}
                    <i data-lucide="clock" class="w-3 h-3"></i>
                  {{/if}}
                  {{status}}
                </span>
              </td>
              <td class="px-3 md:px-4 py-3 md:py-4 text-center">
                <div class="flex justify-center gap-1.5 md:gap-2 flex-wrap">
                  <!-- View Button -->
                  <button onclick="event.stopPropagation(); viewBlotterDetails(this.closest('tr'))" 
                    class="btn-ripple bg-gradient-to-br from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-2 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-blue-300 active:scale-95 flex items-center gap-1.5 text-xs md:text-sm font-semibold">
                    <i data-lucide="eye" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                    <span>View</span>
                  </button>

                  <!-- Edit Button -->
                  <a href="/blotters/edit/{{_id}}" onclick="event.stopPropagation()" 
                    class="btn-ripple bg-gradient-to-br from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-2 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-green-300 active:scale-95 flex items-center gap-1.5 text-xs md:text-sm font-semibold">
                    <i data-lucide="edit" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                    <span>Edit</span>
                  </a>

                  <!-- Delete Button -->
                  <button onclick="event.stopPropagation(); showDeleteModal('{{_id}}')" 
                    class="btn-ripple bg-gradient-to-br from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white px-2 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-red-300 active:scale-95 flex items-center gap-1.5 text-xs md:text-sm font-semibold">
                    <i data-lucide="trash-2" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                    <span>Delete</span>
                  </button>
                </div>
              </td>
            </tr>
            {{else}}
            <tr id="emptyRow">
              <td colspan="6" class="text-center py-12">
                <i data-lucide="inbox" class="w-16 h-16 text-gray-300 mx-auto mb-3"></i>
                <p class="text-gray-500 font-medium">No blotter reports found.</p>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- View Details Modal -->
  <div id="viewModal" class="hidden fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-3xl shadow-2xl max-w-3xl w-full my-8 animate-scaleIn">
      <div class="bg-gradient-to-r from-green-600 to-green-700 text-white p-6 rounded-t-3xl">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <i data-lucide="file-text" class="w-8 h-8"></i>
            <h3 class="text-2xl font-bold">Blotter Report Details</h3>
          </div>
          <button onclick="closeViewModal()" class="hover:bg-white hover:bg-opacity-20 p-2 rounded-lg transition-all">
            <i data-lucide="x" class="w-6 h-6"></i>
          </button>
        </div>
      </div>
      <div class="p-6 max-h-[70vh] overflow-y-auto">
        <!-- Status Badge -->
        <div class="mb-6 flex justify-between items-center">
          <span id="detailStatus" class="px-4 py-2 rounded-full text-sm font-bold inline-flex items-center gap-2"></span>
          <span id="detailDate" class="text-sm text-gray-500"></span>
        </div>

        <!-- Complainant Section -->
        <div class="mb-6 bg-blue-50 rounded-xl p-4 border-2 border-blue-200">
          <h4 class="font-bold text-blue-900 mb-3 flex items-center gap-2">
            <i data-lucide="user" class="w-5 h-5"></i>
            Complainant Information
          </h4>
          <div class="grid md:grid-cols-2 gap-3">
            <div>
              <p class="text-xs text-blue-600 font-semibold">Name</p>
              <p id="detailComplainantName" class="text-gray-800 font-medium"></p>
            </div>
            <div>
              <p class="text-xs text-blue-600 font-semibold">Contact</p>
              <p id="detailComplainantContact" class="text-gray-800"></p>
            </div>
            <div class="md:col-span-2">
              <p class="text-xs text-blue-600 font-semibold">Address</p>
              <p id="detailComplainantAddress" class="text-gray-800"></p>
            </div>
          </div>
        </div>

        <!-- Respondent Section -->
        <div class="mb-6 bg-red-50 rounded-xl p-4 border-2 border-red-200">
          <h4 class="font-bold text-red-900 mb-3 flex items-center gap-2">
            <i data-lucide="user-x" class="w-5 h-5"></i>
            Respondent Information
          </h4>
          <div class="grid md:grid-cols-2 gap-3">
            <div>
              <p class="text-xs text-red-600 font-semibold">Name</p>
              <p id="detailRespondentName" class="text-gray-800 font-medium"></p>
            </div>
            <div>
              <p class="text-xs text-red-600 font-semibold">Contact</p>
              <p id="detailRespondentContact" class="text-gray-800"></p>
            </div>
            <div class="md:col-span-2">
              <p class="text-xs text-red-600 font-semibold">Address</p>
              <p id="detailRespondentAddress" class="text-gray-800"></p>
            </div>
          </div>
        </div>

        <!-- Incident Details -->
        <div class="mb-6 bg-yellow-50 rounded-xl p-4 border-2 border-yellow-200">
          <h4 class="font-bold text-yellow-900 mb-3 flex items-center gap-2">
            <i data-lucide="alert-circle" class="w-5 h-5"></i>
            Incident Details
          </h4>
          <div class="grid md:grid-cols-2 gap-3">
            <div>
              <p class="text-xs text-yellow-600 font-semibold">Type</p>
              <p id="detailIncidentType" class="text-gray-800 font-medium"></p>
            </div>
            <div>
              <p class="text-xs text-yellow-600 font-semibold">Date & Time</p>
              <p id="detailIncidentDateTime" class="text-gray-800"></p>
            </div>
            <div class="md:col-span-2">
              <p class="text-xs text-yellow-600 font-semibold">Location</p>
              <p id="detailLocation" class="text-gray-800"></p>
            </div>
            <div class="md:col-span-2">
              <p class="text-xs text-yellow-600 font-semibold">Description</p>
              <p id="detailDescription" class="text-gray-800 whitespace-pre-wrap"></p>
            </div>
          </div>
        </div>

        <!-- Action Taken -->
        <div class="mb-6 bg-green-50 rounded-xl p-4 border-2 border-green-200">
          <h4 class="font-bold text-green-900 mb-3 flex items-center gap-2">
            <i data-lucide="clipboard-check" class="w-5 h-5"></i>
            Action Taken
          </h4>
          <p id="detailActionTaken" class="text-gray-800 whitespace-pre-wrap"></p>
        </div>

        <!-- Reported By -->
        <div class="bg-gray-50 rounded-xl p-4 border-2 border-gray-200">
          <p class="text-xs text-gray-600 font-semibold">Reported By</p>
          <p id="detailReportedBy" class="text-gray-800 font-medium"></p>
        </div>
      </div>
      <div class="p-6 bg-gray-50 rounded-b-3xl flex flex-col sm:flex-row gap-3">
        <button onclick="closeViewModal()" class="btn-ripple flex-1 bg-gradient-to-r from-gray-500 to-gray-600 hover:from-gray-600 hover:to-gray-700 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg active:scale-95 flex items-center justify-center gap-2">
          <i data-lucide="x" class="w-4 h-4"></i>
          Close
        </button>
        <button onclick="printBlotter()" class="btn-ripple flex-1 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-blue-300 active:scale-95 flex items-center justify-center gap-2">
          <i data-lucide="printer" class="w-4 h-4"></i>
          Print
        </button>
        <a id="editBlotterLink" href="#" class="btn-ripple flex-1 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-green-300 active:scale-95 flex items-center justify-center gap-2">
          <i data-lucide="edit" class="w-4 h-4"></i>
          Edit
        </a>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full animate-scaleIn">
      <div class="bg-gradient-to-r from-red-600 to-red-700 text-white p-6 rounded-t-3xl">
        <div class="flex items-center gap-3">
          <i data-lucide="alert-triangle" class="w-8 h-8"></i>
          <h3 class="text-2xl font-bold">Delete Report?</h3>
        </div>
      </div>
      <div class="p-6">
        <p class="text-gray-700 mb-6 text-center">Are you sure you want to delete this blotter report? This action cannot be undone.</p>
        <div class="flex gap-3">
          <button onclick="closeDeleteModal()" class="btn-ripple flex-1 bg-gradient-to-r from-gray-500 to-gray-600 hover:from-gray-600 hover:to-gray-700 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg active:scale-95 flex items-center justify-center gap-2">
            <i data-lucide="x" class="w-4 h-4"></i>
            Cancel
          </button>
          <button onclick="confirmDelete()" class="btn-ripple flex-1 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-red-300 active:scale-95 flex items-center justify-center gap-2">
            <i data-lucide="trash-2" class="w-4 h-4"></i>
            Delete
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Initialize Lucide icons immediately and on DOM ready
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    let currentBlotterId = null;
    let currentBlotterData = null;

    // Calculate and display statistics
    function updateStatistics() {
      const rows = document.querySelectorAll('.blotter-row');
      let pending = 0, resolved = 0, referred = 0;

      rows.forEach(row => {
        const status = row.dataset.status;
        if (status === 'Pending') pending++;
        else if (status === 'Resolved') resolved++;
        else if (status === 'Referred to Police') referred++;
      });

      document.getElementById('pendingCount').textContent = pending;
      document.getElementById('resolvedCount').textContent = resolved;
      document.getElementById('referredCount').textContent = referred;
      document.getElementById('totalCount').textContent = rows.length;
    }

    // Search and Filter functionality
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');

    function filterTable() {
      const searchTerm = searchInput.value.toLowerCase();
      const statusValue = statusFilter.value;
      const rows = document.querySelectorAll('.blotter-row');
      let visibleCount = 0;

      rows.forEach(row => {
        const searchData = row.dataset.search.toLowerCase();
        const rowStatus = row.dataset.status;
        
        const matchesSearch = searchData.includes(searchTerm);
        const matchesStatus = !statusValue || rowStatus === statusValue;

        if (matchesSearch && matchesStatus) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      // Show/hide empty message
      const emptyRow = document.getElementById('emptyRow');
      if (emptyRow) {
        emptyRow.style.display = visibleCount === 0 ? '' : 'none';
      }
    }

    if (searchInput) searchInput.addEventListener('input', filterTable);
    if (statusFilter) statusFilter.addEventListener('change', filterTable);

    // View Blotter Details Modal
    function viewBlotterDetails(row) {
      try {
        const data = JSON.parse(row.dataset.blotter);
        currentBlotterData = data;
        
        // Set status badge
        const statusBadge = document.getElementById('detailStatus');
        let statusClass = '';
        let statusIcon = '';
        
        if (data.status === 'Resolved') {
          statusClass = 'bg-green-100 text-green-700';
          statusIcon = '<i data-lucide="check-circle" class="w-4 h-4"></i>';
        } else if (data.status === 'Referred to Police') {
          statusClass = 'bg-blue-100 text-blue-700';
          statusIcon = '<i data-lucide="shield" class="w-4 h-4"></i>';
        } else {
          statusClass = 'bg-yellow-100 text-yellow-700';
          statusIcon = '<i data-lucide="clock" class="w-4 h-4"></i>';
        }
        
        statusBadge.className = `px-4 py-2 rounded-full text-sm font-bold inline-flex items-center gap-2 ${statusClass}`;
        statusBadge.innerHTML = `${statusIcon} ${data.status}`;
        
        // Set date
        document.getElementById('detailDate').textContent = data.created_at ? new Date(data.created_at).toLocaleDateString() : '';
        
        // Complainant info
        document.getElementById('detailComplainantName').textContent = data.complainant || 'N/A';
        document.getElementById('detailComplainantContact').textContent = data.complainant_contact || 'N/A';
        document.getElementById('detailComplainantAddress').textContent = data.complainant_address || 'N/A';
        
        // Respondent info
        document.getElementById('detailRespondentName').textContent = data.respondent || 'N/A';
        document.getElementById('detailRespondentContact').textContent = data.respondent_contact || 'N/A';
        document.getElementById('detailRespondentAddress').textContent = data.respondent_address || 'N/A';
        
        // Incident details
        document.getElementById('detailIncidentType').textContent = data.incident_type || 'N/A';
        document.getElementById('detailIncidentDateTime').textContent = `${data.incident_date || 'N/A'} ${data.incident_time || ''}`;
        document.getElementById('detailLocation').textContent = data.location || 'N/A';
        document.getElementById('detailDescription').textContent = data.description || 'No description provided';
        
        // Action taken
        document.getElementById('detailActionTaken').textContent = data.action_taken || 'No action taken yet';
        
        // Reported by
        document.getElementById('detailReportedBy').textContent = data.reported_by || 'N/A';
        
        // Set edit link
        document.getElementById('editBlotterLink').href = `/blotters/edit/${data.id}`;
        
        // Show modal
        document.getElementById('viewModal').classList.remove('hidden');
        setTimeout(() => lucide.createIcons(), 100);
      } catch (error) {
        console.error('Error viewing blotter:', error);
        alert('Error loading blotter details');
      }
    }

    function closeViewModal() {
      document.getElementById('viewModal').classList.add('hidden');
      currentBlotterData = null;
    }

    function printBlotter() {
      if (!currentBlotterData) return;
      
      const printWindow = window.open('', '_blank');
      const data = currentBlotterData;
      
      printWindow.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
          <title>Blotter Report - ${data.complainant}</title>
          <style>
            body { font-family: Arial, sans-serif; padding: 40px; line-height: 1.6; }
            .header { text-align: center; margin-bottom: 30px; border-bottom: 3px solid #333; padding-bottom: 20px; }
            .header h1 { margin: 0; color: #16a34a; }
            .section { margin-bottom: 25px; }
            .section-title { font-weight: bold; color: #16a34a; font-size: 18px; margin-bottom: 10px; border-bottom: 2px solid #e5e7eb; padding-bottom: 5px; }
            .info-row { display: flex; margin-bottom: 8px; }
            .info-label { font-weight: bold; width: 150px; }
            .info-value { flex: 1; }
            .status { display: inline-block; padding: 5px 15px; border-radius: 20px; font-weight: bold; }
            .status-pending { background: #fef3c7; color: #92400e; }
            .status-resolved { background: #d1fae5; color: #065f46; }
            .status-referred { background: #dbeafe; color: #1e40af; }
            @media print {
              body { padding: 20px; }
              .no-print { display: none; }
            }
          </style>
        </head>
        <body>
          <div class="header">
            <h1>BARANGAY BLOTTER REPORT</h1>
            <p>Official Incident Report</p>
          </div>
          
          <div class="section">
            <div class="info-row">
              <div class="info-label">Report Date:</div>
              <div class="info-value">${data.created_at ? new Date(data.created_at).toLocaleDateString() : 'N/A'}</div>
            </div>
            <div class="info-row">
              <div class="info-label">Status:</div>
              <div class="info-value">
                <span class="status ${data.status === 'Resolved' ? 'status-resolved' : data.status === 'Referred to Police' ? 'status-referred' : 'status-pending'}">
                  ${data.status}
                </span>
              </div>
            </div>
          </div>

          <div class="section">
            <div class="section-title">COMPLAINANT INFORMATION</div>
            <div class="info-row">
              <div class="info-label">Name:</div>
              <div class="info-value">${data.complainant || 'N/A'}</div>
            </div>
            <div class="info-row">
              <div class="info-label">Contact:</div>
              <div class="info-value">${data.complainant_contact || 'N/A'}</div>
            </div>
            <div class="info-row">
              <div class="info-label">Address:</div>
              <div class="info-value">${data.complainant_address || 'N/A'}</div>
            </div>
          </div>

          <div class="section">
            <div class="section-title">RESPONDENT INFORMATION</div>
            <div class="info-row">
              <div class="info-label">Name:</div>
              <div class="info-value">${data.respondent || 'N/A'}</div>
            </div>
            <div class="info-row">
              <div class="info-label">Contact:</div>
              <div class="info-value">${data.respondent_contact || 'N/A'}</div>
            </div>
            <div class="info-row">
              <div class="info-label">Address:</div>
              <div class="info-value">${data.respondent_address || 'N/A'}</div>
            </div>
          </div>

          <div class="section">
            <div class="section-title">INCIDENT DETAILS</div>
            <div class="info-row">
              <div class="info-label">Type:</div>
              <div class="info-value">${data.incident_type || 'N/A'}</div>
            </div>
            <div class="info-row">
              <div class="info-label">Date & Time:</div>
              <div class="info-value">${data.incident_date || 'N/A'} ${data.incident_time || ''}</div>
            </div>
            <div class="info-row">
              <div class="info-label">Location:</div>
              <div class="info-value">${data.location || 'N/A'}</div>
            </div>
            <div class="info-row">
              <div class="info-label">Description:</div>
              <div class="info-value">${data.description || 'No description provided'}</div>
            </div>
          </div>

          <div class="section">
            <div class="section-title">ACTION TAKEN</div>
            <p>${data.action_taken || 'No action taken yet'}</p>
          </div>

          <div class="section">
            <div class="info-row">
              <div class="info-label">Reported By:</div>
              <div class="info-value">${data.reported_by || 'N/A'}</div>
            </div>
          </div>

          <div class="no-print" style="margin-top: 30px; text-align: center;">
            <button onclick="window.print()" style="padding: 10px 30px; background: #16a34a; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 16px;">Print Report</button>
            <button onclick="window.close()" style="padding: 10px 30px; background: #6b7280; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 16px; margin-left: 10px;">Close</button>
          </div>
        </body>
        </html>
      `);
      
      printWindow.document.close();
    }

    // Delete Modal Functions
    function showDeleteModal(id) {
      currentBlotterId = id;
      document.getElementById('deleteModal').classList.remove('hidden');
      setTimeout(() => lucide.createIcons(), 100);
    }

    function closeDeleteModal() {
      document.getElementById('deleteModal').classList.add('hidden');
      currentBlotterId = null;
    }

    function confirmDelete() {
      if (currentBlotterId) {
        window.location.href = `/blotters/delete/${currentBlotterId}`;
      }
    }

    // Export to CSV
    function exportToCSV() {
      const rows = document.querySelectorAll('.blotter-row');
      if (rows.length === 0) {
        alert('No data to export');
        return;
      }

      let csv = 'Complainant,Respondent,Incident Type,Incident Date,Location,Status,Description\n';
      
      rows.forEach(row => {
        if (row.style.display !== 'none') {
          try {
            const data = JSON.parse(row.dataset.blotter);
            csv += `"${data.complainant || ''}","${data.respondent || ''}","${data.incident_type || ''}","${data.incident_date || ''}","${data.location || ''}","${data.status || ''}","${(data.description || '').replace(/"/g, '""')}"\n`;
          } catch (e) {
            console.error('Error parsing row data:', e);
          }
        }
      });

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `blotter_reports_${new Date().toISOString().split('T')[0]}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      window.URL.revokeObjectURL(url);
    }

    // Close modals on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeDeleteModal();
        closeViewModal();
      }
    });

    // Close modals on backdrop click
    document.getElementById('deleteModal').addEventListener('click', function(e) {
      if (e.target === this) closeDeleteModal();
    });

    document.getElementById('viewModal').addEventListener('click', function(e) {
      if (e.target === this) closeViewModal();
    });

    // Initialize statistics on page load
    updateStatistics();
  </script>

  <script>
    // Ensure all Lucide icons are rendered - multiple attempts for reliability
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    document.addEventListener('DOMContentLoaded', function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    });

    window.addEventListener('load', function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    });

    // Also try after a short delay to catch any late-loading elements
    setTimeout(function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }, 100);
  </script>
</body>
</html>
