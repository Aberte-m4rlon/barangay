{{> head}}
<body class="bg-gradient-to-br from-gray-50 to-green-50 text-gray-800 min-h-screen">
  {{> navbar }}

  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  </script>

  <!-- Header -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <!-- Success/Error Messages -->
    <div id="successMessage" class="hidden mb-4 bg-green-100 border-2 border-green-500 text-green-700 px-4 py-3 rounded-xl flex items-center gap-3 animate-fadeIn">
      <i data-lucide="check-circle" class="w-6 h-6"></i>
      <span class="font-semibold">Settings saved successfully!</span>
    </div>
    <div id="errorMessage" class="hidden mb-4 bg-red-100 border-2 border-red-500 text-red-700 px-4 py-3 rounded-xl flex items-center gap-3 animate-fadeIn">
      <i data-lucide="x-circle" class="w-6 h-6"></i>
      <span class="font-semibold">Error saving settings. Please try again.</span>
    </div>

    <div class="flex items-center gap-3 mb-6 animate-fadeIn">
      <a href="/secretary/dashboard" class="bg-gray-100 hover:bg-gray-200 p-2 rounded-lg transition-all">
        <i data-lucide="arrow-left" class="w-6 h-6 text-gray-700"></i>
      </a>
      <div class="flex items-center gap-3">
        <div class="bg-green-100 p-3 rounded-xl">
          <i data-lucide="settings" class="text-green-700 w-8 h-8"></i>
        </div>
        <div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-gray-800">Certificate Settings</h1>
          <p class="text-sm text-gray-600 mt-1">Customize certificate appearance and information</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Settings Form -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <form action="/certificate-settings" method="POST" enctype="multipart/form-data" class="space-y-6">
      
      <!-- Logo Section -->
      <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 p-6 animate-fadeIn">
        <div class="flex items-center gap-3 mb-4">
          <i data-lucide="image" class="w-6 h-6 text-green-600"></i>
          <h2 class="text-xl font-bold text-gray-800">Logo</h2>
        </div>
        <div class="space-y-4">
          {{#if settings.logo_url}}
          <div class="flex items-center gap-4">
            <img src="{{settings.logo_url}}" alt="Current Logo" class="w-20 h-20 object-contain border-2 border-gray-300 rounded-lg">
            <span class="text-sm text-gray-600">Current logo</span>
          </div>
          {{/if}}
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Upload New Logo (Optional)</label>
            <input type="file" name="logo" accept="image/*" 
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none text-sm">
            <p class="text-xs text-gray-500 mt-1">Recommended: Square image, PNG or JPG, max 2MB</p>
          </div>
        </div>
      </div>

      <!-- Header Information -->
      <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 p-6 animate-fadeIn">
        <div class="flex items-center gap-3 mb-4">
          <i data-lucide="file-text" class="w-6 h-6 text-green-600"></i>
          <h2 class="text-xl font-bold text-gray-800">Header Information</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Republic</label>
            <input type="text" name="republic" value="{{settings.republic}}" required
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Province</label>
            <input type="text" name="province" value="{{settings.province}}" required
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Municipality</label>
            <input type="text" name="municipality" value="{{settings.municipality}}" required
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Office Title</label>
            <input type="text" name="office_title" value="{{settings.office_title}}" required
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
          <div class="md:col-span-2">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Barangay Name</label>
            <input type="text" name="barangay_name" value="{{settings.barangay_name}}" required
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
        </div>
      </div>

      <!-- Certificate Title -->
      <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 p-6 animate-fadeIn">
        <div class="flex items-center gap-3 mb-4">
          <i data-lucide="type" class="w-6 h-6 text-green-600"></i>
          <h2 class="text-xl font-bold text-gray-800">Certificate Title</h2>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Title</label>
          <input type="text" name="certificate_title" value="{{settings.certificate_title}}" required
            class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
        </div>
      </div>

      <!-- Signatories -->
      <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 p-6 animate-fadeIn">
        <div class="flex items-center gap-3 mb-4">
          <i data-lucide="users" class="w-6 h-6 text-green-600"></i>
          <h2 class="text-xl font-bold text-gray-800">Signatories</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Secretary Name</label>
            <input type="text" name="secretary_name" value="{{settings.secretary_name}}" required
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Secretary Title</label>
            <input type="text" name="secretary_title" value="{{settings.secretary_title}}" required
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Captain Name</label>
            <input type="text" name="captain_name" value="{{settings.captain_name}}" required
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Captain Title</label>
            <input type="text" name="captain_title" value="{{settings.captain_title}}" required
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
        </div>
      </div>

      <!-- Footer & Seal -->
      <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 p-6 animate-fadeIn">
        <div class="flex items-center gap-3 mb-4">
          <i data-lucide="shield" class="w-6 h-6 text-green-600"></i>
          <h2 class="text-xl font-bold text-gray-800">Footer & Seal</h2>
        </div>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Validity Text</label>
            <input type="text" name="validity_text" value="{{settings.validity_text}}" required
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Seal Text</label>
            <input type="text" name="seal_text" value="{{settings.seal_text}}" required
              class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
          <div class="flex items-center gap-3">
            <input type="checkbox" name="seal_enabled" id="seal_enabled" {{#if settings.seal_enabled}}checked{{/if}}
              class="w-5 h-5 text-green-600 border-2 border-gray-300 rounded focus:ring-2 focus:ring-green-500">
            <label for="seal_enabled" class="text-sm font-semibold text-gray-700">Show Seal on Certificate</label>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Seal Text Line 1</label>
              <input type="text" name="seal_text_line1" value="{{settings.seal_text_line1}}"
                class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Seal Text Line 2</label>
              <input type="text" name="seal_text_line2" value="{{settings.seal_text_line2}}"
                class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-4 justify-end">
        <a href="/secretary/dashboard" 
          class="btn-ripple bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-xl font-bold transition-all flex items-center gap-2 hover:scale-105 shadow-lg">
          <i data-lucide="x" class="w-5 h-5"></i>
          Cancel
        </a>
        <button type="submit" 
          class="btn-ripple bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white px-6 py-3 rounded-xl font-bold transition-all flex items-center gap-2 hover:scale-105 shadow-lg">
          <i data-lucide="save" class="w-5 h-5"></i>
          Save Settings
        </button>
      </div>

      <!-- Preview Info -->
      <div class="bg-blue-50 border-2 border-blue-200 rounded-xl p-4 mt-4">
        <div class="flex items-start gap-3">
          <i data-lucide="info" class="w-6 h-6 text-blue-600 flex-shrink-0 mt-1"></i>
          <div>
            <h3 class="font-bold text-blue-800 mb-1">Preview Your Changes</h3>
            <p class="text-sm text-blue-700">After saving, go to Secretary Dashboard → Approve a request → Click "Print" to see your customized certificate.</p>
          </div>
        </div>
      </div>

    </form>
  </div>

  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    setTimeout(function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }, 100);

    window.addEventListener('load', function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    });

    // Show success/error messages based on URL parameters
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('success') === 'true') {
      const successMsg = document.getElementById('successMessage');
      successMsg.classList.remove('hidden');
      setTimeout(() => {
        successMsg.classList.add('hidden');
        // Remove query parameter from URL
        window.history.replaceState({}, document.title, window.location.pathname);
      }, 5000);
    }
    if (urlParams.get('error') === 'true') {
      const errorMsg = document.getElementById('errorMessage');
      errorMsg.classList.remove('hidden');
      setTimeout(() => {
        errorMsg.classList.add('hidden');
        // Remove query parameter from URL
        window.history.replaceState({}, document.title, window.location.pathname);
      }, 5000);
    }
  </script>

</body>
</html>
