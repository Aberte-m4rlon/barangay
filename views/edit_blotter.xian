<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Blotter Report</title>
  <link rel="stylesheet" href="/tailwind.css" />
  <link rel="stylesheet" href="/custom-styles.css" />
  <script src="https://unpkg.com/lucide@latest/dist/lucide.js"></script>
</head>
<body class="bg-gradient-to-br from-gray-50 to-green-50 min-h-screen font-sans">
{{> head }}
  {{> navbar }}
  
  <div class="max-w-4xl mx-auto py-8 md:py-12 px-4 sm:px-6 lg:px-8 animate-fadeIn">
    <div class="bg-white shadow-2xl rounded-3xl p-6 md:p-10 border-2 border-gray-200">
      
      <div class="flex items-center gap-3 mb-8">
        <div class="bg-green-100 p-3 rounded-xl">
          <i data-lucide="edit" class="text-green-700 w-8 h-8"></i>
        </div>
        <h1 class="text-2xl md:text-4xl font-extrabold text-gray-800">Edit Blotter Report</h1>
      </div>

      <form action="/blotters/edit/{{blotter._id}}" method="POST" class="space-y-6">

        <!-- Complainant Info -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">
              <i data-lucide="user" class="inline w-4 h-4 mr-1"></i> Complainant Name
            </label>
            <input type="text" name="complainant_name" value="{{blotter.complainant_name}}" required 
                   class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">
              <i data-lucide="phone" class="inline w-4 h-4 mr-1"></i> Complainant Contact
            </label>
            <input type="text" name="complainant_contact" value="{{blotter.complainant_contact}}"
                   class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
        </div>

        <!-- Respondent Info -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">
              <i data-lucide="user-x" class="inline w-4 h-4 mr-1"></i> Respondent Name
            </label>
            <input type="text" name="respondent_name" value="{{blotter.respondent_name}}" required 
                   class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">
              <i data-lucide="phone-call" class="inline w-4 h-4 mr-1"></i> Respondent Contact
            </label>
            <input type="text" name="respondent_contact" value="{{blotter.respondent_contact}}"
                   class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
        </div>

        <!-- Incident Details -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">
              <i data-lucide="alert-circle" class="inline w-4 h-4 mr-1"></i> Incident Type
            </label>
            <select name="incident_type" class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
              <option value="">Select type</option>
              <option value="Physical Altercation" {{#if (eq blotter.incident_type "Physical Altercation")}}selected{{/if}}>Physical Altercation</option>
              <option value="Theft" {{#if (eq blotter.incident_type "Theft")}}selected{{/if}}>Theft</option>
              <option value="Verbal Argument" {{#if (eq blotter.incident_type "Verbal Argument")}}selected{{/if}}>Verbal Argument</option>
              <option value="Domestic Issue" {{#if (eq blotter.incident_type "Domestic Issue")}}selected{{/if}}>Domestic Issue</option>
              <option value="Other" {{#if (eq blotter.incident_type "Other")}}selected{{/if}}>Other</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">
              <i data-lucide="calendar" class="inline w-4 h-4 mr-1"></i> Incident Date & Time
            </label>
            <input type="datetime-local" name="incident_date" value="{{blotter.incident_date}}"
                   class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">
            <i data-lucide="map-pin" class="inline w-4 h-4 mr-1"></i> Location of Incident
          </label>
          <input type="text" name="location" value="{{blotter.location}}"
                 class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">
            <i data-lucide="file-text" class="inline w-4 h-4 mr-1"></i> Description
          </label>
          <textarea name="description" rows="4" placeholder="Describe the incident..."
                    class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">{{blotter.description}}</textarea>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">
            <i data-lucide="tool" class="inline w-4 h-4 mr-1"></i> Action Taken
          </label>
          <textarea name="action_taken" rows="3" placeholder="Action taken by Barangay officials..."
                    class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">{{blotter.action_taken}}</textarea>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">
            <i data-lucide="check-square" class="inline w-4 h-4 mr-1"></i> Status
          </label>
          <select name="status" 
                  class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none">
            <option value="Pending" {{#if (eq blotter.status "Pending")}}selected{{/if}}>Pending</option>
            <option value="Resolved" {{#if (eq blotter.status "Resolved")}}selected{{/if}}>Resolved</option>
            <option value="Referred to Police" {{#if (eq blotter.status "Referred to Police")}}selected{{/if}}>Referred to Police</option>
          </select>
        </div>

        <div class="flex justify-end gap-4 pt-6">
          <a href="/blotter" class="bg-gray-400 hover:bg-gray-500 text-white px-6 py-3 rounded-xl font-semibold transition-all flex items-center gap-2">
            <i data-lucide="x" class="w-4 h-4"></i>
            Cancel
          </a>
          <button type="submit" class="btn-ripple bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white px-6 py-3 rounded-xl font-bold transition-all flex items-center gap-2 shadow-lg hover:scale-105">
            <i data-lucide="save" class="w-5 h-5"></i>
            Update Report
          </button>
        </div>

      </form>
    </div>
  </div>

  <script>
    // Initialize Lucide icons
    lucide.createIcons();
  </script>
</body>
</html>
