{{> head}}
<body class="bg-gradient-to-br from-gray-50 to-green-50 min-h-screen">
  {{> navbar }}
  
  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  </script>

  <!-- Header -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 animate-fadeIn">
      <div class="flex items-center gap-3">
        <div class="bg-blue-100 p-3 rounded-xl">
          <i data-lucide="file-text" class="text-blue-700 w-8 h-8 md:w-10 md:h-10"></i>
        </div>
        <div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-gray-800">Indigency Requests</h1>
          <p class="text-sm text-gray-600 mt-1">Review and manage certificate requests</p>
        </div>
      </div>
      <a href="/secretary/dashboard" class="btn-ripple bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 md:px-5 md:py-3 rounded-xl font-semibold shadow-lg transition-all flex items-center gap-2 hover:scale-105">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> 
        <span>Back</span>
      </a>
    </div>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6 animate-fadeIn">
      <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-xl p-5 border-2 border-yellow-200 hover-lift">
        <div class="flex items-center gap-3">
          <div class="bg-yellow-500 p-3 rounded-lg">
            <i data-lucide="clock" class="w-6 h-6 text-white"></i>
          </div>
          <div>
            <p class="text-xs text-yellow-600 font-semibold">Pending</p>
            <p class="text-2xl md:text-3xl font-bold text-yellow-700" id="pendingCount">0</p>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-5 border-2 border-green-200 hover-lift">
        <div class="flex items-center gap-3">
          <div class="bg-green-500 p-3 rounded-lg">
            <i data-lucide="check-circle" class="w-6 h-6 text-white"></i>
          </div>
          <div>
            <p class="text-xs text-green-600 font-semibold">Approved</p>
            <p class="text-2xl md:text-3xl font-bold text-green-700" id="approvedCount">0</p>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-xl p-5 border-2 border-red-200 hover-lift">
        <div class="flex items-center gap-3">
          <div class="bg-red-500 p-3 rounded-lg">
            <i data-lucide="x-circle" class="w-6 h-6 text-white"></i>
          </div>
          <div>
            <p class="text-xs text-red-600 font-semibold">Rejected</p>
            <p class="text-2xl md:text-3xl font-bold text-red-700" id="rejectedCount">0</p>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-5 border-2 border-blue-200 hover-lift">
        <div class="flex items-center gap-3">
          <div class="bg-blue-500 p-3 rounded-lg">
            <i data-lucide="list" class="w-6 h-6 text-white"></i>
          </div>
          <div>
            <p class="text-xs text-blue-600 font-semibold">Total</p>
            <p class="text-2xl md:text-3xl font-bold text-blue-700" id="totalCount">0</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white rounded-xl shadow-md p-4 mb-6 animate-fadeIn">
      <div class="flex flex-col md:flex-row gap-3">
        <div class="flex-1">
          <div class="relative">
            <i data-lucide="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400"></i>
            <input type="text" id="searchInput" placeholder="Search by name, address, or purpose..." 
              class="w-full pl-10 pr-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all outline-none text-sm">
          </div>
        </div>
        <select id="statusFilter" class="px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all outline-none text-sm">
          <option value="">All Status</option>
          <option value="Pending">Pending</option>
          <option value="Approved">Approved</option>
          <option value="Rejected">Rejected</option>
        </select>
      </div>
    </div>

    <!-- Requests Table -->
    <div class="bg-white rounded-2xl shadow-2xl overflow-hidden border-2 border-gray-200 animate-fadeIn">
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm text-left border-collapse">
          <thead class="bg-gradient-to-r from-blue-600 to-blue-700 text-white">
            <tr>
              <th class="px-3 md:px-4 py-3 md:py-4 font-bold">Name</th>
              <th class="px-3 md:px-4 py-3 md:py-4 font-bold hidden md:table-cell">Address</th>
              <th class="px-3 md:px-4 py-3 md:py-4 font-bold">Purpose</th>
              <th class="px-3 md:px-4 py-3 md:py-4 font-bold hidden lg:table-cell">Date</th>
              <th class="px-3 md:px-4 py-3 md:py-4 font-bold">Status</th>
              <th class="px-3 md:px-4 py-3 md:py-4 text-center font-bold">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            {{#each indigency_requests}}
              <tr class="hover:bg-blue-50 transition-colors request-row" 
                  data-status="{{status}}" 
                  data-search="{{full_name}} {{address}} {{purpose}}">
                <td class="px-3 md:px-4 py-3 md:py-4 text-xs md:text-sm">
                  <div class="font-semibold text-gray-800">{{full_name}}</div>
                  <div class="text-gray-500 text-xs mt-1 md:hidden">{{address}}</div>
                </td>
                <td class="px-3 md:px-4 py-3 md:py-4 text-gray-600 text-xs md:text-sm hidden md:table-cell">{{address}}</td>
                <td class="px-3 md:px-4 py-3 md:py-4 text-xs md:text-sm">
                  <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded-lg font-medium">{{purpose}}</span>
                </td>
                <td class="px-3 md:px-4 py-3 md:py-4 text-gray-600 text-xs md:text-sm hidden lg:table-cell">
                  <div class="flex items-center gap-1">
                    <i data-lucide="calendar" class="w-3 h-3"></i>
                    {{date_requested}}
                  </div>
                </td>
                <td class="px-3 md:px-4 py-3 md:py-4">
                  <span class="px-2 md:px-3 py-1 rounded-full text-xs font-bold inline-flex items-center gap-1
                    {{#if (eq status 'Approved')}}bg-green-100 text-green-700
                    {{else if (eq status 'Rejected')}}bg-red-100 text-red-700
                    {{else}}bg-yellow-100 text-yellow-700{{/if}}">
                    {{#if (eq status 'Approved')}}
                      <i data-lucide="check-circle" class="w-3 h-3"></i>
                    {{else if (eq status 'Rejected')}}
                      <i data-lucide="x-circle" class="w-3 h-3"></i>
                    {{else}}
                      <i data-lucide="clock" class="w-3 h-3"></i>
                    {{/if}}
                    {{status}}
                  </span>
                </td>
                <td class="px-3 md:px-4 py-3 md:py-4 text-center">
                  <div class="flex justify-center gap-1.5 md:gap-2 flex-wrap">
                    {{#if (eq status "Pending")}}
                      <button onclick="showApproveModal('{{_id}}', '{{full_name}}')" 
                        class="btn-ripple bg-gradient-to-br from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-2 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-green-300 active:scale-95 flex items-center gap-1.5 text-xs md:text-sm font-semibold">
                        <i data-lucide="check" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                        <span>Approve</span>
                      </button>
                      <button onclick="showRejectModal('{{_id}}', '{{full_name}}')" 
                        class="btn-ripple bg-gradient-to-br from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white px-2 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-red-300 active:scale-95 flex items-center gap-1.5 text-xs md:text-sm font-semibold">
                        <i data-lucide="x" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                        <span>Reject</span>
                      </button>
                    {{else}}
                      <button onclick="viewRequest('{{_id}}')" 
                        class="btn-ripple bg-gradient-to-br from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-2 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-blue-300 active:scale-95 flex items-center gap-1.5 text-xs md:text-sm font-semibold">
                        <i data-lucide="eye" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                        <span>View</span>
                      </button>
                    {{/if}}
                  </div>
                </td>
              </tr>
            {{else}}
              <tr>
                <td colspan="6" class="text-center py-12">
                  <i data-lucide="inbox" class="w-16 h-16 text-gray-300 mx-auto mb-3"></i>
                  <p class="text-gray-500 font-medium">No indigency requests found.</p>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Approve Modal -->
  <div id="approveModal" class="hidden fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full animate-scaleIn">
      <div class="bg-gradient-to-r from-green-600 to-green-700 text-white p-6 rounded-t-3xl">
        <div class="flex items-center gap-3">
          <i data-lucide="check-circle" class="w-8 h-8"></i>
          <h3 class="text-2xl font-bold">Approve Request</h3>
        </div>
      </div>
      <div class="p-6">
        <p class="text-gray-700 mb-6 text-center">Are you sure you want to approve the indigency request for <strong id="approveName"></strong>?</p>
        <div class="flex gap-3">
          <button onclick="closeApproveModal()" class="btn-ripple flex-1 bg-gradient-to-r from-gray-500 to-gray-600 hover:from-gray-600 hover:to-gray-700 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg active:scale-95 flex items-center justify-center gap-2">
            <i data-lucide="x" class="w-4 h-4"></i>
            Cancel
          </button>
          <button onclick="confirmApprove()" class="btn-ripple flex-1 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-green-300 active:scale-95 flex items-center justify-center gap-2">
            <i data-lucide="check" class="w-4 h-4"></i>
            Approve
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Reject Modal -->
  <div id="rejectModal" class="hidden fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full animate-scaleIn">
      <div class="bg-gradient-to-r from-red-600 to-red-700 text-white p-6 rounded-t-3xl">
        <div class="flex items-center gap-3">
          <i data-lucide="x-circle" class="w-8 h-8"></i>
          <h3 class="text-2xl font-bold">Reject Request</h3>
        </div>
      </div>
      <div class="p-6">
        <p class="text-gray-700 mb-6 text-center">Are you sure you want to reject the indigency request for <strong id="rejectName"></strong>?</p>
        <div class="flex gap-3">
          <button onclick="closeRejectModal()" class="btn-ripple flex-1 bg-gradient-to-r from-gray-500 to-gray-600 hover:from-gray-600 hover:to-gray-700 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg active:scale-95 flex items-center justify-center gap-2">
            <i data-lucide="x" class="w-4 h-4"></i>
            Cancel
          </button>
          <button onclick="confirmReject()" class="btn-ripple flex-1 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-red-300 active:scale-95 flex items-center justify-center gap-2">
            <i data-lucide="trash-2" class="w-4 h-4"></i>
            Reject
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    let currentRequestId = null;

    // Calculate statistics
    function updateStatistics() {
      const rows = document.querySelectorAll('.request-row');
      let pending = 0, approved = 0, rejected = 0;

      rows.forEach(row => {
        const status = row.dataset.status;
        if (status === 'Pending') pending++;
        else if (status === 'Approved') approved++;
        else if (status === 'Rejected') rejected++;
      });

      document.getElementById('pendingCount').textContent = pending;
      document.getElementById('approvedCount').textContent = approved;
      document.getElementById('rejectedCount').textContent = rejected;
      document.getElementById('totalCount').textContent = rows.length;
    }

    // Search and Filter
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');

    function filterTable() {
      const searchTerm = searchInput.value.toLowerCase();
      const statusValue = statusFilter.value;
      const rows = document.querySelectorAll('.request-row');
      let visibleCount = 0;

      rows.forEach(row => {
        const searchData = row.dataset.search.toLowerCase();
        const rowStatus = row.dataset.status;
        
        const matchesSearch = searchData.includes(searchTerm);
        const matchesStatus = !statusValue || rowStatus === statusValue;

        if (matchesSearch && matchesStatus) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });
    }

    if (searchInput) searchInput.addEventListener('input', filterTable);
    if (statusFilter) statusFilter.addEventListener('change', filterTable);

    // Modal functions
    function showApproveModal(id, name) {
      currentRequestId = id;
      document.getElementById('approveName').textContent = name;
      document.getElementById('approveModal').classList.remove('hidden');
      setTimeout(() => lucide.createIcons(), 100);
    }

    function closeApproveModal() {
      document.getElementById('approveModal').classList.add('hidden');
      currentRequestId = null;
    }

    function confirmApprove() {
      if (currentRequestId) {
        window.location.href = `/indigency/${currentRequestId}/approve`;
      }
    }

    function showRejectModal(id, name) {
      currentRequestId = id;
      document.getElementById('rejectName').textContent = name;
      document.getElementById('rejectModal').classList.remove('hidden');
      setTimeout(() => lucide.createIcons(), 100);
    }

    function closeRejectModal() {
      document.getElementById('rejectModal').classList.add('hidden');
      currentRequestId = null;
    }

    function confirmReject() {
      if (currentRequestId) {
        window.location.href = `/indigency/${currentRequestId}/reject`;
      }
    }

    function viewRequest(id) {
      window.location.href = `/indigency/${id}`;
    }

    // Close modals on ESC
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeApproveModal();
        closeRejectModal();
      }
    });

    // Close on backdrop click
    document.getElementById('approveModal').addEventListener('click', function(e) {
      if (e.target === this) closeApproveModal();
    });

    document.getElementById('rejectModal').addEventListener('click', function(e) {
      if (e.target === this) closeRejectModal();
    });

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
      updateStatistics();
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    });

    setTimeout(function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }, 100);
  </script>
</body>
</html>
