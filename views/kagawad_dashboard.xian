<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kagawad Dashboard | BORS</title>
  <link rel="stylesheet" href="/tailwind.css" />
  <link rel="stylesheet" href="/custom-styles.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gradient-to-br from-orange-50 via-white to-orange-50 text-gray-800 font-sans min-h-screen">

{{> navbar }}

<section class="py-12 px-4 md:px-8">
  <div class="max-w-7xl mx-auto">
    
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-4xl font-extrabold gradient-text mb-2">Kagawad Dashboard</h1>
      <p class="text-gray-600">Welcome back, {{user.username}}!</p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      
      <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-orange-600">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-600 font-semibold">Total Residents</p>
            <h2 class="text-3xl font-bold text-gray-800 mt-1">{{totalResidents}}</h2>
          </div>
          <div class="bg-orange-100 p-4 rounded-full">
            <i data-lucide="users" class="w-8 h-8 text-orange-600"></i>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-green-600">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-600 font-semibold">Announcements</p>
            <h2 class="text-3xl font-bold text-gray-800 mt-1">{{totalAnnouncements}}</h2>
          </div>
          <div class="bg-green-100 p-4 rounded-full">
            <i data-lucide="megaphone" class="w-8 h-8 text-green-600"></i>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-lg p-6 border-l-4 border-red-600">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-600 font-semibold">Blotter Reports</p>
            <h2 class="text-3xl font-bold text-gray-800 mt-1">{{totalBlotters}}</h2>
          </div>
          <div class="bg-red-100 p-4 rounded-full">
            <i data-lucide="file-text" class="w-8 h-8 text-red-600"></i>
          </div>
        </div>
      </div>

    </div>

    <!-- Recent Announcements -->
    <div class="bg-white rounded-2xl shadow-lg p-6">
      <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
        <i data-lucide="bell" class="w-6 h-6 text-orange-600"></i>
        Recent Announcements
      </h2>
      
      {{#if announcements.length}}
        <div class="space-y-4">
          {{#each announcements}}
            <div class="border-l-4 border-orange-500 bg-orange-50 p-4 rounded-lg">
              <h3 class="font-bold text-lg text-gray-800">{{this.title}}</h3>
              <p class="text-gray-600 text-sm mt-1">{{this.message}}</p>
              <p class="text-xs text-gray-500 mt-2">Posted: {{this.date_posted}}</p>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="text-gray-500 text-center py-8">No announcements yet.</p>
      {{/if}}
      
      <div class="mt-6 text-center">
        <a href="/announcements" class="text-orange-600 font-semibold hover:underline">View All Announcements →</a>
      </div>
    </div>

  </div>
</section>

{{> footer }}

<script>
  lucide.createIcons();
</script>

</body>
</html>
