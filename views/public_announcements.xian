<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Community Announcements | BORS</title>
  <link rel="stylesheet" href="/tailwind.css" />
  <link rel="stylesheet" href="/custom-styles.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">

  {{> head }}

  <!-- Header -->
  <section class="bg-gradient-to-r from-green-600 via-green-700 to-green-800 py-12 md:py-16 shadow-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 bg-white/20 text-white px-4 py-2 rounded-full text-sm font-semibold mb-4">
          <i data-lucide="megaphone" class="w-4 h-4"></i>
          Community Updates
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold text-white mb-4">
          Barangay Announcements
        </h1>
        <p class="text-lg md:text-xl text-green-50 max-w-2xl mx-auto">
          Stay informed with the latest news and updates from your community
        </p>
      </div>
    </div>
  </section>

  <!-- Announcements Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    {{#if announcements.length}}
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {{#each announcements}}
        <a href="/public/announcement/{{this.id}}" class="group block">
          <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-100 hover:border-green-300 overflow-hidden transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl">
            <!-- Media Preview -->
            {{#if this.media.length}}
              <div class="relative h-56 overflow-hidden bg-gradient-to-br from-green-100 to-green-200">
                {{#if (or (endsWith this.media.[0] ".jpg") (endsWith this.media.[0] ".jpeg") (endsWith this.media.[0] ".png") (endsWith this.media.[0] ".gif") (endsWith this.media.[0] ".webp"))}}
                  <img src="/uploads/{{this.media.[0]}}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" alt="{{this.title}}">
                  {{#if this.media.[1]}}
                    <div class="absolute top-4 right-4 bg-black/70 backdrop-blur-sm text-white px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5">
                      <i data-lucide="images" class="w-3.5 h-3.5"></i>
                      +{{this.media.length}}
                    </div>
                  {{/if}}
                {{else if (or (endsWith this.media.[0] ".mp4") (endsWith this.media.[0] ".mov") (endsWith this.media.[0] ".avi") (endsWith this.media.[0] ".webm") (endsWith this.media.[0] ".mkv"))}}
                  <video class="w-full h-full object-cover bg-black" preload="metadata">
                    <source src="/uploads/{{this.media.[0]}}" type="video/mp4">
                  </video>
                  <div class="absolute inset-0 flex items-center justify-center bg-black/30">
                    <div class="w-16 h-16 bg-white/90 rounded-full flex items-center justify-center">
                      <i data-lucide="play" class="w-8 h-8 text-green-700"></i>
                    </div>
                  </div>
                {{/if}}
              </div>
            {{else}}
              <div class="h-56 bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center">
                <i data-lucide="megaphone" class="w-20 h-20 text-green-400"></i>
              </div>
            {{/if}}

            <!-- Content -->
            <div class="p-6">
              <div class="flex items-center gap-2 mb-3">
                <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                  <i data-lucide="user" class="w-4 h-4 text-green-700"></i>
                </div>
                <span class="text-sm font-medium text-gray-600">{{this.posted_by}}</span>
                <span class="text-gray-400">•</span>
                <span class="text-sm text-gray-500">{{this.date_posted}}</span>
              </div>
              
              <h3 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2 group-hover:text-green-700 transition-colors">
                {{this.title}}
              </h3>
              
              <p class="text-gray-600 leading-relaxed line-clamp-3 mb-4">
                {{this.message}}
              </p>

              <!-- Footer -->
              <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                <div class="flex items-center gap-4">
                  <div class="flex items-center gap-1.5 text-sm text-gray-500">
                    <i data-lucide="calendar" class="w-4 h-4"></i>
                    <span>{{this.date_posted}}</span>
                  </div>
                  {{#if this.commentCount}}
                    <div class="flex items-center gap-1.5 text-sm text-green-600">
                      <i data-lucide="message-circle" class="w-4 h-4"></i>
                      <span>{{this.commentCount}}</span>
                    </div>
                  {{/if}}
                </div>
                {{#if this.media.length}}
                  <div class="flex items-center gap-1 text-sm text-gray-500">
                    <i data-lucide="image" class="w-4 h-4"></i>
                    <span>{{this.media.length}}</span>
                  </div>
                {{/if}}
              </div>

              <!-- Read More -->
              <div class="mt-4">
                <span class="inline-flex items-center gap-2 text-green-700 font-semibold text-sm group-hover:gap-3 transition-all">
                  Read More
                  <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </span>
              </div>
            </div>
          </div>
        </a>
        {{/each}}
      </div>
    {{else}}
      <!-- Empty State -->
      <div class="text-center py-20 bg-white rounded-3xl border-2 border-dashed border-gray-300">
        <div class="w-20 h-20 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-4">
          <i data-lucide="megaphone" class="w-10 h-10 text-gray-400"></i>
        </div>
        <h3 class="text-2xl font-bold text-gray-700 mb-2">No Announcements Yet</h3>
        <p class="text-gray-500 mb-6">Check back later for community updates and news</p>
        <a href="/" class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-xl font-semibold transition-all">
          <i data-lucide="home" class="w-5 h-5"></i>
          Back to Home
        </a>
      </div>
    {{/if}}
  </section>

  {{> footer }}

  <script>
    lucide.createIcons();
  </script>
</body>
</html>
