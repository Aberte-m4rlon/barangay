<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register | BORS</title>
  <link rel="stylesheet" href="/tailwind.css" />
  <link rel="stylesheet" href="/custom-styles.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gradient-to-br from-green-50 via-white to-green-50 text-gray-800 font-sans min-h-screen">

{{> head }}

<section class="py-12 md:py-20 px-4">
  <div class="max-w-md mx-auto bg-white border-2 border-gray-200 rounded-3xl shadow-2xl p-8 md:p-10 animate-scaleIn">
    <div class="text-center mb-8">
      <div class="flex justify-center mb-4">
        <div class="bg-gradient-to-br from-green-600 to-green-800 p-4 rounded-full">
          <i data-lucide="user-plus" class="w-12 h-12 text-white"></i>
        </div>
      </div>
      <h1 class="text-3xl md:text-4xl font-extrabold gradient-text mb-2">Resident Registration</h1>
      <p class="text-sm text-gray-600">Register as a Barangay Labasan resident</p>
    </div>

<form id="registerForm" action="/register" method="POST" enctype="multipart/form-data" class="space-y-5">

  <!-- Email -->
  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
      <i data-lucide="mail" class="w-4 h-4 text-green-700"></i>
      Email
    </label>
    <input type="email" name="email" required placeholder="your@email.com"
      class="w-full border-2 border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-green-600 focus:border-green-600 transition-all outline-none" />
  </div>

  <!-- Username -->
  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
      <i data-lucide="user" class="w-4 h-4 text-green-700"></i>
      Username
    </label>
    <input type="text" name="username" required placeholder="Choose a username"
      class="w-full border-2 border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-green-600 focus:border-green-600 transition-all outline-none" />
  </div>

  <!-- Password -->
  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
      <i data-lucide="lock" class="w-4 h-4 text-green-700"></i>
      Password
    </label>
    <input type="password" name="password" required placeholder="Create a strong password"
      class="w-full border-2 border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-green-600 focus:border-green-600 transition-all outline-none" />
  </div>

  <!-- Contact Number -->
  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
      <i data-lucide="phone" class="w-4 h-4 text-green-700"></i>
      Contact Number
    </label>
    <input type="text" name="phone" placeholder="09XXXXXXXXX" required
      class="w-full border-2 border-gray-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-green-600 focus:border-green-600 transition-all outline-none" />
  </div>

  <!-- Hidden Role Field (Resident) -->
  <input type="hidden" name="role" value="Resident" />

 <div>
  <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
    <i data-lucide="image" class="w-4 h-4 text-green-700"></i>
    Profile Photo (Optional)
  </label>
  <input type="file" name="profilePhoto" accept="image/*"
    class="w-full border-2 border-gray-300 rounded-xl px-4 py-3 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-green-100 file:text-green-700 file:font-semibold hover:file:bg-green-200 transition-all" />
</div>


  <button type="submit"
    class="btn-ripple w-full bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white py-3 rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-2">
    <i data-lucide="user-check" class="w-5 h-5"></i>
    Register
  </button>
</form>



    <p class="text-center text-sm text-gray-500 mt-5">
      Already have an account?
      <a href="/login" class="text-green-700 font-semibold hover:underline">Login</a>
    </p>
  </div>
  {{> footer }}
</section>

<!-- ✅ MODAL -->
<div id="statusModal" class="fixed inset-0 flex items-center justify-center bg-black/60 backdrop-blur-sm hidden z-50">
  <div class="bg-white rounded-3xl shadow-2xl p-8 w-80 text-center animate-scaleIn">
    <div id="modalIcon" class="mx-auto mb-4"></div>
    <h2 id="modalMessage" class="text-lg font-bold text-gray-800"></h2>
  </div>
</div>


<script>
// Initialize Lucide icons
lucide.createIcons();
function showModal(iconHTML, message) {
  const modal = document.getElementById("statusModal");
  const modalIcon = document.getElementById("modalIcon");
  const modalMessage = document.getElementById("modalMessage");

  modalIcon.innerHTML = iconHTML;
  modalMessage.textContent = message;
  modal.classList.remove("hidden");

  setTimeout(() => {
    modal.classList.add("hidden");
  }, 2500);
}

document.getElementById("registerForm").addEventListener("submit", async function (e) {
  e.preventDefault();

  const formData = new FormData(this);
  const data = Object.fromEntries(formData.entries());

  // ✅ Show loading modal
  showModal(`
    <div class="w-14 h-14 border-4 border-gray-300 border-t-green-600 rounded-full animate-spin mx-auto"></div>
  `, "Submitting request...");

  try {
    const formData = new FormData(this);

    const res = await fetch("/register", {
      method: "POST",
      body: formData // ✅ send as FormData (files + text)
    });


    const result = await res.json();

    setTimeout(() => {
      if (result.success) {
        showModal(`
          <svg class="w-16 h-16 text-green-600 animate-bounce mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M5 13l4 4L19 7"></path>
          </svg>
        `, result.message || "Registration successful! You can now login.");
        this.reset();
        
        // Redirect to login after 2 seconds
        setTimeout(() => {
          window.location.href = "/login";
        }, 2000);
      } else {
        showModal(`
          <svg class="w-16 h-16 text-red-600 animate-bounce mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        `, result.message || "Registration failed. Try again.");
      }
    }, 1200);

  } catch (error) {
    showModal(`
      <svg class="w-16 h-16 text-red-600 animate-bounce mx-auto" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    `, "Server error! Please try again later.");
  }
});
</script>


</body>
</html>
