<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Request Indigency | BORS</title>
  <link rel="stylesheet" href="/tailwind.css" />
  <link rel="stylesheet" href="/custom-styles.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gradient-to-br from-green-50 via-white to-green-50 text-gray-800 font-sans antialiased min-h-screen">

  {{> head }}
  {{> navbar }}

  <section class="max-w-3xl mx-auto px-4 md:px-6 py-12 md:py-16 animate-fadeIn">
  <div class="text-center mb-8">
    <div class="flex justify-center mb-4">
      <div class="bg-gradient-to-br from-green-600 to-green-800 p-4 rounded-full">
        <i data-lucide="file-badge" class="w-12 h-12 md:w-16 md:h-16 text-white"></i>
      </div>
    </div>
    <h1 class="text-3xl md:text-5xl font-extrabold gradient-text mb-3">Request Certificate of Indigency</h1>
    <p class="text-gray-600">Fill out the form below and receive your certificate via email</p>
  </div>

  {{#if success}}
    <!-- Success Modal -->
    <div class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-40 animate-fadeIn">
      <div class="bg-white p-8 rounded-2xl shadow-xl text-center animate-scaleIn">
        <svg class="w-20 h-20 text-green-600 mx-auto mb-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M5 13l4 4L19 7" />
        </svg>
        <h2 class="text-2xl font-semibold text-green-700 mb-2">Request Submitted!</h2>
        <p class="text-gray-600 mb-6">Your request has been sent to the Barangay Office. Please wait for approval and email response.</p>
        <a href="/" class="bg-green-700 hover:bg-green-800 text-white px-6 py-3 rounded-lg">OK</a>
      </div>
    </div>

    <style>
      @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
      @keyframes scaleIn { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
      .animate-fadeIn { animation: fadeIn .3s ease-out; }
      .animate-scaleIn { animation: scaleIn .3s ease-out; }
    </style>
  {{/if}}

  <form action="/request-indigency" method="POST" class="bg-white p-6 md:p-10 rounded-3xl shadow-2xl space-y-6 border-2 border-gray-200">

    <div>
      <label class="font-bold text-gray-700 flex items-center gap-2 mb-2">
        <i data-lucide="user" class="w-5 h-5 text-green-700"></i>
        Full Name
      </label>
      <input type="text" name="full_name" required placeholder="Enter your full name" class="w-full p-3 md:p-4 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none" />
    </div>

    <div>
      <label class="font-bold text-gray-700 flex items-center gap-2 mb-2">
        <i data-lucide="map-pin" class="w-5 h-5 text-green-700"></i>
        Address
      </label>
      <input type="text" name="address" required placeholder="Enter your complete address" class="w-full p-3 md:p-4 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none" />
    </div>

    <div>
      <label class="font-bold text-gray-700 flex items-center gap-2 mb-2">
        <i data-lucide="mail" class="w-5 h-5 text-green-700"></i>
        Email Address (Where Certificate Will Be Sent)
      </label>
      <input type="email" name="email" required placeholder="your@email.com" class="w-full p-3 md:p-4 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none" />
    </div>

    <div>
      <label class="font-bold text-gray-700 flex items-center gap-2 mb-2">
        <i data-lucide="file-text" class="w-5 h-5 text-green-700"></i>
        Purpose
      </label>
      <textarea name="purpose" rows="4" required placeholder="State the purpose of your request..." class="w-full p-3 md:p-4 border-2 border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none"></textarea>
    </div>

    <button class="btn-ripple w-full bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white font-bold py-3 md:py-4 rounded-xl transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-2 text-lg">
      <i data-lucide="send" class="w-5 h-5"></i>
      Submit Request
    </button>
  </form>
</section>


  {{> footer }}

  <script>
    // Initialize Lucide icons
    lucide.createIcons();
  </script>
</body>
</html>
