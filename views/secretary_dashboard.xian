{{> head}}
<body class="bg-gradient-to-br from-gray-50 to-green-50 text-gray-800 min-h-screen">
  {{> navbar }}
  
  <script>
    // Initialize Lucide icons immediately
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }
  </script>

  <!-- Header -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 animate-fadeIn">
      <div class="flex items-center gap-3">
        <div class="bg-green-100 p-3 rounded-xl">
          <i data-lucide="clipboard-check" class="text-green-700 w-8 h-8 md:w-10 md:h-10"></i>
        </div>
        <div>
          <h1 class="text-2xl md:text-4xl font-extrabold text-gray-800">Secretary Dashboard</h1>
          <p class="text-sm text-gray-600 mt-1">Manage requests and barangay records</p>
        </div>
      </div>
      <div class="flex gap-2">
        <a href="/certificate-settings" class="btn-ripple bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-700 hover:to-indigo-800 text-white px-4 py-2 md:px-5 md:py-3 rounded-xl font-bold shadow-lg transition-all flex items-center gap-2 hover:scale-105">
          <i data-lucide="settings" class="w-5 h-5"></i> 
          <span class="hidden sm:inline">Certificate Settings</span>
        </a>
        <a href="/indigency/new" class="btn-ripple bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white px-4 py-2 md:px-5 md:py-3 rounded-xl font-bold shadow-lg transition-all flex items-center gap-2 hover:scale-105">
          <i data-lucide="plus" class="w-5 h-5"></i> 
          <span class="hidden sm:inline">New Request</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Dashboard Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <main class="space-y-6">

      <!-- Summary Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 animate-fadeIn">
        <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-xl p-5 border-2 border-yellow-200 hover-lift">
          <div class="flex items-center gap-3">
            <div class="bg-yellow-500 p-3 rounded-lg">
              <i data-lucide="clock" class="w-6 h-6 text-white"></i>
            </div>
            <div>
              <p class="text-xs text-yellow-600 font-semibold">Pending</p>
              <p class="text-2xl md:text-3xl font-bold text-yellow-700">{{pending_indigency}}</p>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-5 border-2 border-green-200 hover-lift">
          <div class="flex items-center gap-3">
            <div class="bg-green-500 p-3 rounded-lg">
              <i data-lucide="check-circle" class="w-6 h-6 text-white"></i>
            </div>
            <div>
              <p class="text-xs text-green-600 font-semibold">Approved</p>
              <p class="text-2xl md:text-3xl font-bold text-green-700">{{approved_requests}}</p>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-xl p-5 border-2 border-red-200 hover-lift">
          <div class="flex items-center gap-3">
            <div class="bg-red-500 p-3 rounded-lg">
              <i data-lucide="x-circle" class="w-6 h-6 text-white"></i>
            </div>
            <div>
              <p class="text-xs text-red-600 font-semibold">Rejected</p>
              <p class="text-2xl md:text-3xl font-bold text-red-700">{{rejected_requests}}</p>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-5 border-2 border-blue-200 hover-lift">
          <div class="flex items-center gap-3">
            <div class="bg-blue-500 p-3 rounded-lg">
              <i data-lucide="file-text" class="w-6 h-6 text-white"></i>
            </div>
            <div>
              <p class="text-xs text-blue-600 font-semibold">Total</p>
              <p class="text-2xl md:text-3xl font-bold text-blue-700" id="totalRequests">0</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="bg-white rounded-xl shadow-md p-4 animate-fadeIn">
        <div class="flex flex-col md:flex-row gap-3">
          <div class="flex-1">
            <div class="relative">
              <i data-lucide="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400"></i>
              <input type="text" id="searchInput" placeholder="Search by name, address, or purpose..." 
                class="w-full pl-10 pr-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none text-sm">
            </div>
          </div>
          <select id="statusFilter" class="px-4 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all outline-none text-sm">
            <option value="">All Status</option>
            <option value="Pending">Pending</option>
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
          </select>
          <button onclick="exportToCSV()" class="btn-ripple bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white px-4 py-2 rounded-lg font-semibold transition-all flex items-center gap-2 hover:scale-105">
            <i data-lucide="download" class="w-4 h-4"></i>
            <span class="hidden sm:inline">Export</span>
          </button>
        </div>
      </div>

      <!-- Indigency Requests Table -->
      <section class="bg-white rounded-2xl shadow-2xl overflow-hidden border-2 border-gray-200 animate-fadeIn">
        <div class="p-4 md:p-6 border-b border-gray-200 bg-gradient-to-r from-green-50 to-green-100">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <div class="flex items-center gap-2">
              <i data-lucide="file-text" class="w-6 h-6 text-green-700"></i>
              <h2 class="text-xl font-bold text-green-700">Indigency Requests</h2>
            </div>
            <span class="text-sm text-gray-600" id="requestCount">0 requests</span>
          </div>
        </div>

        {{#if indigency_requests.length}}
          <div class="overflow-x-auto">
            <table class="min-w-full text-sm text-left border-collapse">
              <thead class="bg-gradient-to-r from-green-600 to-green-700 text-white">
                <tr>
                  <th class="px-3 md:px-4 py-3 md:py-4 font-bold">Name</th>
                  <th class="px-3 md:px-4 py-3 md:py-4 font-bold hidden md:table-cell">Address</th>
                  <th class="px-3 md:px-4 py-3 md:py-4 font-bold">Purpose</th>
                  <th class="px-3 md:px-4 py-3 md:py-4 font-bold hidden lg:table-cell">Date</th>
                  <th class="px-3 md:px-4 py-3 md:py-4 font-bold">Status</th>
                  <th class="px-3 md:px-4 py-3 md:py-4 text-center font-bold">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                {{#each indigency_requests}}
                  <tr class="hover:bg-green-50 transition-colors request-row" 
                      data-status="{{status}}" 
                      data-search="{{full_name}} {{address}} {{purpose}}">
                    <td class="px-3 md:px-4 py-3 md:py-4 text-xs md:text-sm">
                      <div class="font-semibold text-gray-800">{{full_name}}</div>
                      <div class="text-gray-500 text-xs mt-1 md:hidden">{{address}}</div>
                    </td>
                    <td class="px-3 md:px-4 py-3 md:py-4 text-gray-600 text-xs md:text-sm hidden md:table-cell">{{address}}</td>
                    <td class="px-3 md:px-4 py-3 md:py-4 text-xs md:text-sm">
                      <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded-lg font-medium">{{purpose}}</span>
                    </td>
                    <td class="px-3 md:px-4 py-3 md:py-4 text-gray-600 text-xs md:text-sm hidden lg:table-cell">
                      <div class="flex items-center gap-1">
                        <i data-lucide="calendar" class="w-3 h-3"></i>
                        {{date_requested}}
                      </div>
                    </td>
                    <td class="px-3 md:px-4 py-3 md:py-4">
                      <span class="px-2 md:px-3 py-1 rounded-full text-xs font-bold inline-flex items-center gap-1
                        {{#if (eq status 'Approved')}}bg-green-100 text-green-700
                        {{else if (eq status 'Rejected')}}bg-red-100 text-red-700
                        {{else}}bg-yellow-100 text-yellow-700{{/if}}">
                        {{#if (eq status 'Approved')}}
                          <i data-lucide="check-circle" class="w-3 h-3"></i>
                        {{else if (eq status 'Rejected')}}
                          <i data-lucide="x-circle" class="w-3 h-3"></i>
                        {{else}}
                          <i data-lucide="clock" class="w-3 h-3"></i>
                        {{/if}}
                        {{status}}
                      </span>
                    </td>
                    <td class="px-3 md:px-4 py-3 md:py-4 text-center">
                      <div class="flex justify-center gap-1.5 md:gap-2 flex-wrap">
                        {{#if (eq status "Pending")}}
                          <button onclick="showApproveModal('{{id}}', '{{full_name}}')" 
                            class="btn-ripple bg-gradient-to-br from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-2 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-green-300 active:scale-95 flex items-center gap-1.5 text-xs md:text-sm font-semibold">
                            <i data-lucide="check" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                            <span>Approve</span>
                          </button>
                          <button onclick="showRejectModal('{{id}}', '{{full_name}}')" 
                            class="btn-ripple bg-gradient-to-br from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white px-2 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-red-300 active:scale-95 flex items-center gap-1.5 text-xs md:text-sm font-semibold">
                            <i data-lucide="x" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                            <span>Reject</span>
                          </button>
                        {{else if (eq status "Approved")}}
                          <a href="/indigency/{{id}}/print" target="_blank"
                            class="btn-ripple bg-gradient-to-br from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white px-2 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-purple-300 active:scale-95 flex items-center gap-1.5 text-xs md:text-sm font-semibold">
                            <i data-lucide="printer" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                            <span>Print</span>
                          </a>
                          <button onclick="viewRequest('{{id}}')" 
                            class="btn-ripple bg-gradient-to-br from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-2 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-blue-300 active:scale-95 flex items-center gap-1.5 text-xs md:text-sm font-semibold">
                            <i data-lucide="eye" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                            <span>View</span>
                          </button>
                        {{else}}
                          <button onclick="viewRequest('{{id}}')" 
                            class="btn-ripple bg-gradient-to-br from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white px-2 py-1.5 md:px-3 md:py-2 rounded-lg md:rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-blue-300 active:scale-95 flex items-center gap-1.5 text-xs md:text-sm font-semibold">
                            <i data-lucide="eye" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                            <span>View</span>
                          </button>
                        {{/if}}
                      </div>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="text-center py-12">
            <i data-lucide="inbox" class="w-16 h-16 text-gray-300 mx-auto mb-3"></i>
            <p class="text-gray-500 font-medium">No indigency requests available at the moment.</p>
          </div>
        {{/if}}
      </section>

      <!-- Recent Announcements -->
      <section class="animate-fadeIn">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl md:text-2xl font-extrabold text-gray-800 flex items-center gap-3">
              <div class="bg-gradient-to-br from-green-100 to-green-200 p-2 md:p-3 rounded-xl">
                <i data-lucide="megaphone" class="w-5 h-5 md:w-6 md:h-6 text-green-600"></i>
              </div>
              Recent Announcements
            </h2>
            <p class="text-sm text-gray-600 mt-1 ml-12 md:ml-14">Latest updates from the barangay</p>
          </div>
          <a href="/announcements" class="btn-ripple bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-2 md:px-4 md:py-2 text-xs md:text-sm rounded-xl font-semibold transition-all flex items-center gap-2 hover:scale-105 shadow-md">
            <i data-lucide="list" class="w-4 h-4"></i>
            <span class="hidden sm:inline">View All</span>
          </a>
        </div>

        {{#if announcements.length}}
        <!-- Grid Layout for Announcements -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
          {{#each announcements}}
          <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 hover:border-green-300 overflow-hidden hover-lift card-glow transition-all duration-300 group">
            <!-- Media Preview -->
            {{#if this.media.length}}
              <div class="relative h-40 md:h-48 overflow-hidden bg-gradient-to-br from-green-50 to-green-100">
                {{#if (or (endsWith this.media.[0] ".jpg") (endsWith this.media.[0] ".png") (endsWith this.media.[0] ".jpeg") (endsWith this.media.[0] ".gif") (endsWith this.media.[0] ".webp"))}}
                  <img src="/uploads/{{this.media.[0]}}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                  {{#if this.media.[1]}}
                    <div class="absolute top-2 right-2 bg-black bg-opacity-70 text-white px-2 py-1 rounded-lg text-xs font-bold flex items-center gap-1">
                      <i data-lucide="images" class="w-3 h-3"></i>
                      +{{this.media.length}}
                    </div>
                  {{/if}}
                {{else if (or (endsWith this.media.[0] ".mp4") (endsWith this.media.[0] ".mov") (endsWith this.media.[0] ".avi") (endsWith this.media.[0] ".webm") (endsWith this.media.[0] ".mkv"))}}
                  <video class="w-full h-full object-cover bg-black" preload="metadata">
                    <source src="/uploads/{{this.media.[0]}}" type="video/mp4">
                  </video>
                  <div class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-30">
                    <i data-lucide="play-circle" class="w-12 h-12 text-white"></i>
                  </div>
                  {{#if this.media.[1]}}
                    <div class="absolute top-2 right-2 bg-black bg-opacity-70 text-white px-2 py-1 rounded-lg text-xs font-bold flex items-center gap-1">
                      <i data-lucide="images" class="w-3 h-3"></i>
                      +{{this.media.length}}
                    </div>
                  {{/if}}
                {{/if}}
              </div>
            {{else}}
              <div class="h-40 md:h-48 bg-gradient-to-br from-green-100 to-green-200 flex items-center justify-center">
                <i data-lucide="megaphone" class="w-16 h-16 text-green-400"></i>
              </div>
            {{/if}}

            <!-- Content -->
            <div class="p-4 md:p-5">
              <h3 class="text-base md:text-lg font-bold text-gray-800 mb-2 line-clamp-2 group-hover:text-green-600 transition-colors">{{title}}</h3>
              <p class="text-sm text-gray-600 leading-relaxed mb-3 line-clamp-3">{{message}}</p>
              
              <!-- Footer -->
              <div class="flex items-center justify-between pt-3 border-t border-gray-200">
                <div class="flex items-center gap-2 text-xs text-gray-500">
                  <i data-lucide="user" class="w-3 h-3"></i>
                  <span class="font-medium">{{posted_by}}</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-gray-500">
                  <i data-lucide="calendar" class="w-3 h-3"></i>
                  <span>{{date_posted}}</span>
                </div>
              </div>
            </div>
          </div>
          {{/each}}
        </div>

        <!-- View All Button (Mobile) -->
        <div class="mt-6 text-center">
          <a href="/announcements" class="inline-flex items-center gap-2 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white px-6 py-3 rounded-xl font-bold shadow-lg hover:shadow-xl transition-all hover:scale-105">
            <i data-lucide="arrow-right" class="w-5 h-5"></i>
            View All Announcements
          </a>
        </div>

        {{else}}
        <!-- Empty State -->
        <div class="text-center py-16 bg-gradient-to-br from-green-50 to-green-100 rounded-2xl border-2 border-dashed border-green-300">
          <div class="bg-white p-4 rounded-full w-20 h-20 mx-auto mb-4 flex items-center justify-center">
            <i data-lucide="megaphone" class="w-10 h-10 text-green-400"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-700 mb-2">No Announcements Yet</h3>
          <p class="text-gray-600">No announcements at the moment.</p>
        </div>
        {{/if}}
      </section>

    </main>
  </div>

  <!-- Approve Modal -->
  <div id="approveModal" class="hidden fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full animate-scaleIn">
      <div class="bg-gradient-to-r from-green-600 to-green-700 text-white p-6 rounded-t-3xl">
        <div class="flex items-center gap-3">
          <i data-lucide="check-circle" class="w-8 h-8"></i>
          <h3 class="text-2xl font-bold">Approve Request</h3>
        </div>
      </div>
      <div class="p-6">
        <p class="text-gray-700 mb-6 text-center">Are you sure you want to approve the indigency request for <strong id="approveName"></strong>?</p>
        <div class="flex gap-3">
          <button onclick="closeApproveModal()" class="btn-ripple flex-1 bg-gradient-to-r from-gray-500 to-gray-600 hover:from-gray-600 hover:to-gray-700 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg active:scale-95 flex items-center justify-center gap-2">
            <i data-lucide="x" class="w-4 h-4"></i>
            Cancel
          </button>
          <button onclick="confirmApprove()" class="btn-ripple flex-1 bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-green-300 active:scale-95 flex items-center justify-center gap-2">
            <i data-lucide="check" class="w-4 h-4"></i>
            Approve
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Reject Modal -->
  <div id="rejectModal" class="hidden fixed inset-0 bg-black bg-opacity-60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full animate-scaleIn">
      <div class="bg-gradient-to-r from-red-600 to-red-700 text-white p-6 rounded-t-3xl">
        <div class="flex items-center gap-3">
          <i data-lucide="x-circle" class="w-8 h-8"></i>
          <h3 class="text-2xl font-bold">Reject Request</h3>
        </div>
      </div>
      <div class="p-6">
        <p class="text-gray-700 mb-6 text-center">Are you sure you want to reject the indigency request for <strong id="rejectName"></strong>?</p>
        <div class="flex gap-3">
          <button onclick="closeRejectModal()" class="btn-ripple flex-1 bg-gradient-to-r from-gray-500 to-gray-600 hover:from-gray-600 hover:to-gray-700 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg active:scale-95 flex items-center justify-center gap-2">
            <i data-lucide="x" class="w-4 h-4"></i>
            Cancel
          </button>
          <button onclick="confirmReject()" class="btn-ripple flex-1 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white px-4 py-3 rounded-xl font-bold transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-red-300 active:scale-95 flex items-center justify-center gap-2">
            <i data-lucide="trash-2" class="w-4 h-4"></i>
            Reject
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Initialize Lucide icons
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    let currentRequestId = null;

    // Calculate total requests
    function updateStatistics() {
      const pending = parseInt(document.querySelector('.text-yellow-700').textContent) || 0;
      const approved = parseInt(document.querySelector('.text-green-700').textContent) || 0;
      const rejected = parseInt(document.querySelector('.text-red-700').textContent) || 0;
      const total = pending + approved + rejected;
      
      document.getElementById('totalRequests').textContent = total;
      
      const rows = document.querySelectorAll('.request-row');
      document.getElementById('requestCount').textContent = `${rows.length} request${rows.length !== 1 ? 's' : ''}`;
    }

    // Search and Filter functionality
    const searchInput = document.getElementById('searchInput');
    const statusFilter = document.getElementById('statusFilter');

    function filterTable() {
      const searchTerm = searchInput.value.toLowerCase();
      const statusValue = statusFilter.value;
      const rows = document.querySelectorAll('.request-row');
      let visibleCount = 0;

      rows.forEach(row => {
        const searchData = row.dataset.search.toLowerCase();
        const rowStatus = row.dataset.status;
        
        const matchesSearch = searchData.includes(searchTerm);
        const matchesStatus = !statusValue || rowStatus === statusValue;

        if (matchesSearch && matchesStatus) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      document.getElementById('requestCount').textContent = `${visibleCount} request${visibleCount !== 1 ? 's' : ''}`;
    }

    if (searchInput) searchInput.addEventListener('input', filterTable);
    if (statusFilter) statusFilter.addEventListener('change', filterTable);

    // Approve Modal Functions
    function showApproveModal(id, name) {
      currentRequestId = id;
      document.getElementById('approveName').textContent = name;
      document.getElementById('approveModal').classList.remove('hidden');
      setTimeout(() => lucide.createIcons(), 100);
    }

    function closeApproveModal() {
      document.getElementById('approveModal').classList.add('hidden');
      currentRequestId = null;
    }

    function confirmApprove() {
      if (currentRequestId) {
        window.location.href = `/indigency/${currentRequestId}/approve`;
      }
    }

    // Reject Modal Functions
    function showRejectModal(id, name) {
      currentRequestId = id;
      document.getElementById('rejectName').textContent = name;
      document.getElementById('rejectModal').classList.remove('hidden');
      setTimeout(() => lucide.createIcons(), 100);
    }

    function closeRejectModal() {
      document.getElementById('rejectModal').classList.add('hidden');
      currentRequestId = null;
    }

    function confirmReject() {
      if (currentRequestId) {
        window.location.href = `/indigency/${currentRequestId}/reject`;
      }
    }

    // View Request
    function viewRequest(id) {
      window.location.href = `/indigency/${id}`;
    }

    // Export to CSV
    function exportToCSV() {
      const rows = document.querySelectorAll('.request-row');
      if (rows.length === 0) {
        alert('No data to export');
        return;
      }

      let csv = 'Name,Address,Purpose,Date,Status\n';
      
      rows.forEach(row => {
        if (row.style.display !== 'none') {
          const cells = row.querySelectorAll('td');
          const name = cells[0].querySelector('.font-semibold').textContent.trim();
          const address = cells[1] ? cells[1].textContent.trim() : cells[0].querySelector('.text-gray-500').textContent.trim();
          const purpose = cells[2].textContent.trim();
          const date = cells[3] ? cells[3].textContent.trim() : 'N/A';
          const status = cells[4].textContent.trim();
          
          csv += `"${name}","${address}","${purpose}","${date}","${status}"\n`;
        }
      });

      const blob = new Blob([csv], { type: 'text/csv' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `indigency_requests_${new Date().toISOString().split('T')[0]}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      window.URL.revokeObjectURL(url);
    }

    // Close modals on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeApproveModal();
        closeRejectModal();
      }
    });

    // Close modals on backdrop click
    document.getElementById('approveModal').addEventListener('click', function(e) {
      if (e.target === this) closeApproveModal();
    });

    document.getElementById('rejectModal').addEventListener('click', function(e) {
      if (e.target === this) closeRejectModal();
    });

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
      updateStatistics();
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    });

    // Multiple icon initialization attempts
    setTimeout(function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    }, 100);

    window.addEventListener('load', function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
      }
    });
  </script>

</body>
</html>
