<section class="py-20">
  <div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-lg">
    <h1 class="text-2xl font-bold text-green-700 text-center mb-5">Verify Email</h1>
    <p class="text-sm text-center text-gray-600 mb-4">Enter the 6-digit code sent to <b>{{email}}</b></p>

    <form action="/verify-otp" method="POST" class="space-y-5">
      <input type="hidden" name="email" value="{{email}}">
      <input type="text" name="otp" maxlength="6" required
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-center text-2xl tracking-widest">

      <button class="w-full bg-green-700 hover:bg-green-800 text-white py-2 rounded-lg transition">Verify</button>
    </form>
  </div>
</section>
