<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Indigency Request Details | BORS</title>
  <link rel="stylesheet" href="/tailwind.css">
  <link rel="stylesheet" href="/custom-styles.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gradient-to-br from-gray-50 to-green-50 text-gray-800">
  {{> head}}
  {{> navbar }}

  <section class="bg-gradient-to-r from-green-600 to-green-800 py-8 md:py-12 text-center text-white shadow-2xl relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-0 w-64 h-64 bg-white rounded-full mix-blend-multiply filter blur-3xl animate-float"></div>
    </div>
    <div class="relative z-10 animate-fadeIn">
      <div class="flex justify-center mb-3">
        <i data-lucide="file-text" class="w-12 h-12 text-white"></i>
      </div>
    <h1 class="text-3xl font-bold">Indigency Request Details</h1>
  </section>

  <div class="max-w-4xl mx-auto px-6 py-12">
    <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1">Full Name</label>
          <p class="text-lg text-gray-800">{{request.full_name}}</p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1">Email</label>
          <p class="text-lg text-gray-800">{{request.email}}</p>
        </div>
        <div class="md:col-span-2">
          <label class="block text-sm font-semibold text-gray-600 mb-1">Address</label>
          <p class="text-lg text-gray-800">{{request.address}}</p>
        </div>
        <div class="md:col-span-2">
          <label class="block text-sm font-semibold text-gray-600 mb-1">Purpose</label>
          <p class="text-lg text-gray-800">{{request.purpose}}</p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1">Date Requested</label>
          <p class="text-lg text-gray-800">{{request.date_requested}}</p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1">Status</label>
          {{#if (eq request.status "Pending")}}
            <span class="bg-yellow-100 text-yellow-800 px-4 py-2 rounded-full text-sm font-medium inline-block">Pending</span>
          {{else if (eq request.status "Approved")}}
            <span class="bg-green-100 text-green-800 px-4 py-2 rounded-full text-sm font-medium inline-block">Approved</span>
          {{else}}
            <span class="bg-red-100 text-red-800 px-4 py-2 rounded-full text-sm font-medium inline-block">Rejected</span>
          {{/if}}
        </div>
      </div>

      <div class="mt-8 flex gap-4">
        <a href="/secretary_dashboard" class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-2 rounded-lg">Back to Dashboard</a>
        {{#if (eq request.status "Pending")}}
          <a href="/indigency/{{request._id}}/approve" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg">Approve</a>
          <a href="/indigency/{{request._id}}/reject" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg">Reject</a>
        {{/if}}
      </div>
    </div>
  </div>

  {{> footer}}

  <script>
    // Initialize Lucide icons
    lucide.createIcons();
  </script>
</body>
</html>
